{
  "id": "C-GOLD-014",
  "title": "journal exhaustion fails closed without mutating stub state",
  "kind": "data-plane",
  "traces": [
    "§44.14",
    "§43.5",
    "§19.4",
    "§41.9"
  ],
  "note": "The second request is never admitted: it receives no journal sequence number, executes no stub, and mutates no invocation or sequence state — the stub listing still shows 1 invocation, not 2. The failure is sticky with requestSequence null, because there is no journal capacity in which to represent it, which is exactly why journal_full is the one verification code with no matching interaction outcome (§41.7, §43.5). Older interactions are never silently evicted.",
  "config": {
    "schemaVersion": 1,
    "mode": "strict",
    "compatibility": [
      "jev/v1"
    ],
    "stubs": [
      {
        "id": "q-stub",
        "profile": "jev/v1",
        "when": {
          "questions": {
            "q": "noul"
          }
        },
        "then": {
          "answers": {
            "q": {
              "noul": 0.1
            }
          }
        }
      }
    ],
    "limits": {
      "maxInteractions": 1
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/systemone",
        "body": {
          "state": "x",
          "model": "jev-latest",
          "questions": {
            "q": {
              "type": "noul"
            }
          }
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "model": "jev-latest",
          "answers": {
            "q": {
              "type": "noul",
              "noul": 0.1
            }
          },
          "usage": {
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "journal": {
          "sequence": 1,
          "method": "POST",
          "path": "/v1/systemone",
          "profile": "jev/v1",
          "operation": "systemone",
          "outcome": "matched",
          "matchedStubId": "q-stub",
          "status": 200,
          "error": null,
          "requestBody": null,
          "_timestampOmitted": "timestamp is diagnostic only (§8.6, §41.7) and is not asserted"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/systemone",
        "body": {
          "state": "x",
          "model": "jev-latest",
          "questions": {
            "q": {
              "type": "noul"
            }
          }
        }
      },
