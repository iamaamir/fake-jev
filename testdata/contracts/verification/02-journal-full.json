    {
      "request": {
        "method": "GET",
        "path": "/__fake/v1/verify"
      },
      "expect": {
        "status": 200,
        "body": {
          "passed": false,
          "failures": [
            {
              "code": "journal_full",
              "requestSequence": null,
              "stubId": null,
              "message": "<not asserted>"
            }
          ]
        }
      }
    }
  ],
  "verify": {
