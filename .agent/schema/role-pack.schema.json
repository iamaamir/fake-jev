{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-pack.schema.json",
  "title": "Role pack front matter (design §4)",
  "description": "Canonical contract for the YAML front matter of docs/agents/roles/*.md. check_role_packs in scripts/verify-candidate is the validator; parity is scenario-bound (design §11, §13). id == stage and gate == G-<stage> are enforced by the validator, not expressible here.",
  "type": "object",
  "required": ["id", "stage", "expertise", "inputs", "output", "gate", "escalate"],
  "additionalProperties": false,
  "properties": {
    "id": { "enum": ["specifier", "coder", "cleaner", "hardener", "qa"] },
    "stage": { "enum": ["specifier", "coder", "cleaner", "hardener", "qa"] },
    "expertise": {
      "type": "object",
      "required": ["required", "optional"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "optional": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "output": { "type": "string", "const": ".agent/work/<id>/<stage>.md" },
    "gate": { "enum": ["G-S", "G-C", "G-L", "G-H", "G-Q"] },
    "escalate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "blocker"],
        "additionalProperties": false,
        "properties": {
          "condition": { "type": "string", "minLength": 1 },
          "blocker": { "enum": ["spec-gap", "needs-info", "needs-human", "wontfix"] }
        }
      }
    }
  }
}
