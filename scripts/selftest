#!/usr/bin/env python3
"""selftest — scenario suite for the gauntlet tooling (design §12).

usage: scripts/selftest [substring-filter ...]

Builds fixture repositories in temp directories (never modifies this
repository), runs the real scripts against them, and asserts results.
Each filter selects scenarios whose name contains it (OR semantics).
Offline: no network, no sleeps. Exit 0 iff every selected scenario passes.
"""

import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import traceback

REAL = pathlib.Path(__file__).resolve().parent.parent
SCENARIOS = []
_PRISTINE = None
_PRISTINE_DIR = None

COPY_FILES = ["scripts/verify-candidate", "scripts/agent-context",
              "scripts/candidate-fingerprint", "scripts/selftest",
              "README.md", "AGENTS.md", ".gitignore"]
COPY_DIRS = ["docs", "spec"]

# Fixture git must be hermetic: neutralize machine-global/system config
# (gpgsign, hooksPath, useConfigOnly, ...), forbid interactive prompts, and
# guarantee a commit identity regardless of the host's git configuration.
# Ambient GIT_* vars are stripped and this is applied last in sh() so every
# subprocess inherits it over ambient config.
GIT_HERMETIC_ENV = {
    "GIT_CONFIG_GLOBAL": os.devnull,
    "GIT_CONFIG_SYSTEM": os.devnull,
    "GIT_CONFIG_NOSYSTEM": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_AUTHOR_NAME": "selftest",
    "GIT_AUTHOR_EMAIL": "selftest@example",
    "GIT_COMMITTER_NAME": "selftest",
    "GIT_COMMITTER_EMAIL": "selftest@example",
}
COMMAND_TIMEOUT_SECONDS = 120

# Hermetic: in-process script loads must not write __pycache__. The repo does
# not gitignore it, so a stray mtime-bearing .pyc would dirty the tree and
# perturb the candidate digest.
sys.dont_write_bytecode = True


def scenario(name):
    def decorate(fn):
        SCENARIOS.append((name, fn))
        return fn
    return decorate


def sh(cmd, cwd, env=None, check=True, timeout=COMMAND_TIMEOUT_SECONDS):
    if env and any(key.startswith("GIT_") for key in env):
        raise AssertionError(
            "sh() env must not set GIT_* keys: the harness owns the git "
            "environment (ambient GIT_* is stripped and GIT_HERMETIC_ENV is "
            "forced); got: %s"
            % ", ".join(sorted(key for key in env if key.startswith("GIT_"))))
    merged = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    merged.update(env or {})
    merged.update(GIT_HERMETIC_ENV)
    proc = subprocess.run(cmd, shell=True, cwd=str(cwd), env=merged,
                          capture_output=True, text=True, timeout=timeout)
    if check and proc.returncode != 0:
        raise AssertionError("command failed (%d): %s\n%s\n%s"
                             % (proc.returncode, cmd, proc.stdout, proc.stderr))
    return proc


def git_commit(root):
    sh("git -c user.email=selftest@example -c user.name=selftest "
       "commit -qm fixture", root)


def git_init(root):
    sh("git init -q", root)
    sh("git add -A", root)
    git_commit(root)


def build_pristine(directory):
    """One-time copy of the real repository's tooling + docs into a temp git repo."""
    root = pathlib.Path(directory) / "pristine"
    root.mkdir(parents=True)
    for rel in COPY_FILES:
        dest = root / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(REAL / rel, dest)
    for rel in COPY_DIRS:
        shutil.copytree(REAL / rel, root / rel, symlinks=True)
    (root / ".agent").mkdir()
    shutil.copy2(REAL / ".agent" / "README.md", root / ".agent" / "README.md")
    if (REAL / ".agent" / "schema").is_dir():
        shutil.copytree(REAL / ".agent" / "schema", root / ".agent" / "schema")
    if (REAL / ".agent" / "gate-policy.json").is_file():
        shutil.copy2(REAL / ".agent" / "gate-policy.json",
                     root / ".agent" / "gate-policy.json")
    work = root / ".agent" / "work"
    work.mkdir(exist_ok=True)
    for task_id in ("FJ-044", "FJ-045", "FJ-046", "FJ-047"):
        source = REAL / ".agent" / "work" / task_id / "state.json"
        if source.is_file():          # created in Task 3; absent during Task 1 runs
            target = work / task_id
            target.mkdir(exist_ok=True)
            shutil.copy2(source, target / "state.json")
    git_init(root)
    return root


def pristine():
    global _PRISTINE, _PRISTINE_DIR
    if _PRISTINE is None:
        _PRISTINE_DIR = tempfile.TemporaryDirectory(prefix="gauntlet-selftest-")
        _PRISTINE = build_pristine(_PRISTINE_DIR.name)
    return _PRISTINE


def fixture(name, items=None, mutate=None):
    """Fresh copy of the pristine fixture plus optional work items/mutations."""
    root = pathlib.Path(tempfile.mkdtemp(prefix="st-%s-" % name))
    dest = root / "repo"
    shutil.copytree(pristine(), dest, symlinks=True)
    for task_id, state in (items or {}).items():
        work = dest / ".agent" / "work" / task_id
        work.mkdir(parents=True)
        (work / "state.json").write_text(
            json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if mutate:
        mutate(dest)
    return dest


def run_verify(repo, task=None, env=None):
    if task:
        shutil.rmtree(repo / ".agent" / "reports" / task, ignore_errors=True)
    cmd = "./scripts/verify-candidate" + (" %s" % task if task else "")
    proc = sh(cmd, repo, env=env, check=False)
    report = None
    if task:
        reports = sorted((repo / ".agent" / "reports" / task).glob("report-*.json"))
        if reports:
            report = json.loads(reports[-1].read_text(encoding="utf-8"))
    return proc, report


def fingerprint_script(cwd):
    """The scenario cwd may be a bare tree (Task 1 scenarios) without a
    scripts/ copy: fall back to the real repository's script."""
    if (pathlib.Path(cwd) / "scripts" / "candidate-fingerprint").exists():
        return "./scripts/candidate-fingerprint"
    return str(REAL / "scripts" / "candidate-fingerprint")


def candidate_fp(repo, root=None):
    proc = sh("%s candidate%s"
              % (fingerprint_script(repo), " " + str(root) if root else ""), repo)
    return proc.stdout.strip()


def task_fp(state, tmpdir):
    path = pathlib.Path(tmpdir) / "state.json"
    path.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")
    proc = sh("%s task %s" % (fingerprint_script(tmpdir), path),
              pathlib.Path(tmpdir))
    return json.loads(proc.stdout)


def rows(report, name):
    found = [c for c in report["checks"] if c["name"] == name]
    if not found:
        raise AssertionError("no check named %r; have: %s"
                             % (name, sorted({c["name"] for c in report["checks"]})))
    return found[0]


def expect(report, name, *, code=None, result=None, required=None, gate=None):
    row = rows(report, name)
    for key, want in (("code", code), ("result", result),
                      ("required", required), ("gate", gate)):
        if want is not None and row.get(key) != want:
            raise AssertionError("%s: %s=%r, want %r (row: %s)"
                                 % (name, key, row.get(key), want, row))
    return row


def assert_exit(proc, want_zero, context=""):
    got_zero = proc.returncode == 0
    if got_zero != want_zero:
        raise AssertionError("%sexit %d, want zero=%s\n%s"
                             % (context, proc.returncode, want_zero, proc.stdout))


# Design §8.4: a compliant statusHistory path ending in each status — first
# entry planned/ready, every consecutive pair an allowed edge.
HISTORY_PATHS = {
    "planned": ["planned"],
    "ready": ["ready"],
    "implementing": ["planned", "ready", "implementing"],
    "verifying": ["planned", "ready", "implementing", "verifying"],
    "review": ["planned", "ready", "implementing", "verifying", "review"],
    "complete": ["planned", "ready", "implementing", "verifying", "review",
                 "complete"],
    "blocked": ["planned", "blocked"],
}


def base_item(task_id="FJ-900", **overrides):
    """Minimal valid work item; override any field per scenario."""
    state = {
        "id": task_id,
        "title": "Selftest item",
        "phase": "foundation",
        "objective": "Fixture objective",
        "status": "ready",
        "baseRevision": None,
        "candidateRevision": None,
        "assignedRole": None,
        "leaseOwner": None,
        "attempts": 0,
        "specReferences": [],
        "relevantFiles": [],
        "allowedFiles": ["docs/example.md"],
        "acceptance": ["selftest"],
        "nonGoals": [],
        "verificationCommands": [],
        "lastVerification": None,
        "blockers": [],
        "nextAction": "none",
        "notes": [],
    }
    state.update(overrides)
    # §8.4 history must end at the current status; scenarios that test the
    # history rules themselves pass an explicit (invalid) list instead.
    state.setdefault("statusHistory", list(HISTORY_PATHS[state["status"]]))
    return state


def write_artifact(repo, task_id, stage, inp, out, tfp, body="staged evidence",
                   header=None, git_head="0000000", author=True):
    # Default headers carry a per-stage author (§5/§8.5): attribution rows pass
    # for non-grandfathered fixtures, and coder/qa authors never collide.
    if header is None:
        front = (
            "---\n"
            "stage: %s\n"
            "task: %s\n"
            "inputFingerprint: %s\n"
            "outputFingerprint: %s\n"
            "taskFingerprint: %s\n"
            "gitHead: %s\n"
            "generatedAt: 2026-09-25T00:00:00Z\n"
            % (stage, task_id, inp, out, tfp, git_head))
        if author:
            front += "author: selftest/%s\n" % stage
        front += "---\n"
    else:
        front = header
    work = repo / ".agent" / "work" / task_id
    work.mkdir(parents=True, exist_ok=True)
    (work / ("%s.md" % stage)).write_text(front + "\n" + body + "\n",
                                          encoding="utf-8")


def write_chain(repo, task_id, stages, fp, tfp, body="staged evidence",
                author=True):
    """Chain-consistent artifacts: every input == output == fp (valid links + terminal)."""
    for stage in stages:
        write_artifact(repo, task_id, stage, fp, fp, tfp, body=body,
                       author=author)


def write_fixture_report(repo, task_id, required_stages, omit=()):
    """Recorded report carrying the §7 coverage rows for its own recorded
    policy.requiredStages — minus any names in `omit` (for the coverage-failure
    scenario)."""
    rows = []
    for index, stage in enumerate(required_stages):
        names = ["stage.%s.artifact" % stage,
                 "stage.%s.header" % stage,
                 "stage.%s.task_fingerprint" % stage]
        if index > 0:
            names.append("stage.%s.chain" % stage)
        if index == len(required_stages) - 1:
            names.append("stage.%s.terminal" % stage)
        for name in names:
            if name in omit:
                continue
            rows.append({"name": name, "gate": "G-C", "required": True,
                         "result": "pass", "exitCode": 0,
                         "code": "verify.check_failed", "exempted": False,
                         "command": name})
    rel = ".agent/reports/%s/report-fixture.json" % task_id
    path = repo / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    report = {"taskId": task_id, "status": "passed",
              "policy": {"class": "metadata",
                         "requiredStages": list(required_stages),
                         "source": "derived"},
              "checks": rows}
    path.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    return rel


def attach_last_verification(repo, task_id, report_rel):
    """Point an item's lastVerification at a recorded report file (§7)."""
    state_path = repo / ".agent" / "work" / task_id / "state.json"
    state = json.loads(state_path.read_text(encoding="utf-8"))
    state["lastVerification"] = {"status": "passed", "report": report_rel,
                                 "summary": "fixture report",
                                 "finishedAt": "2026-09-25T00:00:00Z",
                                 "revision": "0000000"}
    state_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n",
                          encoding="utf-8")


# --------------------------------------------------------------------------
# Task 1 scenarios: candidate fingerprint (§6.1)
# --------------------------------------------------------------------------

@scenario("candidate_deterministic")
def candidate_deterministic():
    with tempfile.TemporaryDirectory() as td:
        root = pathlib.Path(td) / "r"
        root.mkdir()
        (root / "a.txt").write_text("hello\n")
        git_init(root)
        first = candidate_fp(root, root)
        assert len(first) == 64, first
        second = candidate_fp(root, root)
        assert first == second, "digest not deterministic"
        (root / "a.txt").write_text("hello world\n")
        third = candidate_fp(root, root)
        assert third != first, "content change did not change digest"
        sh("git commit -qam change", root)
        fourth = candidate_fp(root, root)
        assert fourth == third, "commit with identical content changed digest (HEAD must not be identity)"


@scenario("candidate_excludes_evidence_dirs")
def candidate_excludes_evidence_dirs():
    with tempfile.TemporaryDirectory() as td:
        root = pathlib.Path(td) / "r"
        root.mkdir()
        (root / "src.txt").write_text("content\n")
        git_init(root)
        before = candidate_fp(root, root)
        for rel in (".agent/work/FJ-1/artifact.md", ".agent/reports/FJ-1/r.json",
                    ".agent/logs/x.log", ".scratch/tmp.txt"):
            path = root / rel
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text("evidence\n")
        after = candidate_fp(root, root)
        assert before == after, "evidence directories perturbed the digest"
        (root / "src.txt").write_text("changed\n")
        assert candidate_fp(root, root) != after, "source change not reflected"


@scenario("candidate_untracked_and_symlink_modes")
def candidate_untracked_and_symlink_modes():
    with tempfile.TemporaryDirectory() as td:
        root = pathlib.Path(td) / "r"
        root.mkdir()
        (root / "base.txt").write_text("b\n")
        (root / ".gitignore").write_text("ignored/\n")
        git_init(root)
        (root / "plain.txt").write_text("plain\n")
        (root / "tool.sh").write_text("#!/bin/sh\n")
        (root / "tool.sh").chmod(0o755)
        os.symlink("plain.txt", (root / "link"))
        (root / "ignored").mkdir()
        (root / "ignored" / "x.bin").write_text("nope\n")
        fp = candidate_fp(root, root)

        # Independent recomputation of the canonical form for this tiny tree
        # (§6.1 rules: repo-relative / paths, string modes, gitignored excluded,
        #  symlink content = link target bytes).
        entries = []
        for rel, mode, content in [
            (".gitignore", "100644", b"ignored/\n"),
            ("base.txt", "100644", b"b\n"),
            ("link", "120000", b"plain.txt"),
            ("plain.txt", "100644", b"plain\n"),
            ("tool.sh", "100755", b"#!/bin/sh\n"),
        ]:
            entries.append({"path": rel, "mode": mode,
                            "contentSha256": hashlib.sha256(content).hexdigest()})
        entries.sort(key=lambda e: e["path"])
        canonical = json.dumps(entries, sort_keys=True, separators=(",", ":"))
        expected = hashlib.sha256(canonical.encode()).hexdigest()
        assert fp == expected, "digest %s != independently computed %s" % (fp, expected)


@scenario("candidate_tracked_dirty_content")
def candidate_tracked_dirty_content():
    with tempfile.TemporaryDirectory() as td:
        root = pathlib.Path(td) / "r"
        root.mkdir()
        (root / "a.txt").write_text("one\n")
        git_init(root)
        clean = candidate_fp(root, root)
        (root / "a.txt").write_text("two\n")  # unstaged edit: tracked, any worktree state
        assert candidate_fp(root, root) != clean, "unstaged edit not part of workspace content"
        os.remove(root / "a.txt")  # tracked-but-deleted: not workspace content
        deleted = candidate_fp(root, root)
        assert deleted != clean, "deletion not reflected"


# --------------------------------------------------------------------------
# Task 2 scenarios: task fingerprint, classification, scheduling (§6.2, §8)
# --------------------------------------------------------------------------

@scenario("task_workflow_only_fields_ignored")
def task_workflow_only_fields_ignored():
    with tempfile.TemporaryDirectory() as td:
        state = base_item()
        before = task_fp(state, td)["taskFingerprint"]
        for field, value in (("status", "implementing"), ("leaseOwner", "agent-9"),
                             ("attempts", 3), ("stage", "coder"),
                             ("nextAction", "something else"),
                             ("lastVerification", {"status": "passed"}),
                             ("blockers", [{"type": "spec-gap", "description": "x"}])):
            mutated = dict(state)
            mutated[field] = value
            after = task_fp(mutated, td)["taskFingerprint"]
            assert after == before, "workflow-only field %r changed task fingerprint" % field


@scenario("task_semantic_change_changes_fingerprint")
def task_semantic_change_changes_fingerprint():
    with tempfile.TemporaryDirectory() as td:
        before = task_fp(base_item(), td)["taskFingerprint"]
        for field, value in (("nonGoals", ["one more exclusion"]),
                             ("verificationCommands", ["go test ./..."]),
                             ("acceptance", ["extra criterion"]),
                             ("allowedFiles", ["docs/example.md", "docs/other.md"])):
            mutated = dict(base_item())
            mutated[field] = value
            after = task_fp(mutated, td)["taskFingerprint"]
            assert after != before, "semantic field %r did not change fingerprint" % field
        # Absent vs null must hash identically (both omitted, §6.2 canonical form).
        with_null = base_item()
        with_null["nonGoals"] = None
        assert task_fp(with_null, td)["taskFingerprint"] == before


@scenario("task_effective_required_stages_hashing")
def task_effective_required_stages_hashing():
    with tempfile.TemporaryDirectory() as td:
        derived = task_fp(base_item(), td)
        assert derived["source"] == "derived"
        assert derived["requiredStages"] == derived["derivedRequiredStages"]
        # An override that restates the default hashes identically to no override.
        restated = base_item()
        restated["requiredStages"] = derived["derivedRequiredStages"]
        assert task_fp(restated, td)["taskFingerprint"] == derived["taskFingerprint"]
        # A real addition changes the fingerprint and reports explicit source.
        added = base_item()
        added["requiredStages"] = ["specifier", "coder", "cleaner", "hardener", "qa"]
        info = task_fp(added, td)
        assert info["source"] == "explicit"
        assert info["taskFingerprint"] != derived["taskFingerprint"]
        assert info["derivedRequiredStages"] == ["specifier", "coder", "cleaner", "qa"]


@scenario("task_mixed_classes_strongest")
def task_mixed_classes_strongest():
    with tempfile.TemporaryDirectory() as td:
        mixed = base_item()
        mixed["allowedFiles"] = ["docs/example.md", "internal/engine/stub.go"]
        info = task_fp(mixed, td)
        assert info["class"] == "product", info
        assert info["derivedRequiredStages"] == \
            ["specifier", "coder", "cleaner", "hardener", "qa"]
        metadata = base_item()
        metadata["allowedFiles"] = [".agent/work/FJ-900/state.json", "docs/x.md"]
        assert task_fp(metadata, td)["class"] == "metadata"
        # spec/contracts/** must classify product before generic spec/** (metadata).
        contract = base_item()
        contract["allowedFiles"] = ["spec/contracts/vector.json"]
        assert task_fp(contract, td)["class"] == "product"


@scenario("task_unknown_class_unit")
def task_unknown_class_unit():
    with tempfile.TemporaryDirectory() as td:
        unknown = base_item()
        unknown["allowedFiles"] = ["weird/thing.bin"]
        (pathlib.Path(td) / "state.json").write_text(
            json.dumps(unknown), encoding="utf-8")
        proc = sh("%s task %s"
                  % (fingerprint_script(pathlib.Path(td)),
                     pathlib.Path(td) / "state.json"),
                  pathlib.Path(td), check=False)
        assert proc.returncode == 3, (proc.returncode, proc.stderr)
        assert "cannot classify" in proc.stderr


@scenario("task_scheduling_due_sets")
def task_scheduling_due_sets():
    sys.path.insert(0, str(REAL / "scripts"))
    try:
        import importlib.util
        import importlib.machinery
        # spec_from_file_location finds no loader for an extensionless file
        # and returns None; supply SourceFileLoader explicitly.
        loader = importlib.machinery.SourceFileLoader(
            "candidate_fingerprint", str(REAL / "scripts" / "candidate-fingerprint"))
        spec = importlib.util.spec_from_file_location(
            "candidate_fingerprint", REAL / "scripts" / "candidate-fingerprint",
            loader=loader)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
    finally:
        sys.path.pop(0)
    five = ["specifier", "coder", "cleaner", "hardener", "qa"]
    four = ["specifier", "coder", "cleaner", "qa"]
    cases = [
        # (status, stage, required, due, pending)
        ("ready", None, five, [], five),
        ("planned", None, four, [], four),
        ("blocked", "coder", five, [], five),
        ("implementing", "coder", five, ["specifier"],
         ["cleaner", "hardener", "qa"]),
        ("implementing", None, five, five, []),
        ("verifying", "coder", five, ["specifier", "coder"],
         ["cleaner", "hardener", "qa"]),
        ("review", "qa", four, four, []),
        ("complete", "qa", five, five, []),
        ("implementing", "hardener", four, four, []),  # stage outside RS: fail-closed, all due
    ]
    for status, stage, required, due, pending in cases:
        got_due, got_pending = mod.scheduling(status, stage, required)
        assert got_due == due, (status, stage, got_due, due)
        assert got_pending == pending, (status, stage, got_pending, pending)


# --------------------------------------------------------------------------
# Task 3 scenarios: role pack validation (design §4)
# --------------------------------------------------------------------------

ROLE_PACK_TEMPLATE = """---
id: specifier
stage: specifier
expertise:
  required:
    - product-manager
  optional: []
inputs:
  - work-item.objective
output: .agent/work/<id>/<stage>.md
gate: G-S
escalate:
  - condition: spec-change-required
    blocker: spec-gap
---

# Specifier (fixture pack)
"""


def with_specifier_pack(text):
    def apply(repo):
        (repo / "docs" / "agents" / "roles" / "specifier.md").write_text(
            text, encoding="utf-8")
    return apply


@scenario("role_pack_dangling_reference")
def role_pack_dangling_reference():
    repo = fixture("rp-dangling", mutate=with_specifier_pack(
        ROLE_PACK_TEMPLATE.replace("    - product-manager", "    - no-such-pack")))
    proc, _ = run_verify(repo)
    assert_exit(proc, False)
    assert "agent.role_pack_invalid" in proc.stdout, proc.stdout
    assert "dangling expertise reference: no-such-pack" in proc.stdout, proc.stdout


@scenario("role_pack_unknown_key")
def role_pack_unknown_key():
    repo = fixture("rp-unknown", mutate=with_specifier_pack(
        ROLE_PACK_TEMPLATE.replace("gate: G-S", "gate: G-S\nexpertice: []")))
    proc, _ = run_verify(repo)
    assert_exit(proc, False)
    assert "unknown front-matter key: expertice" in proc.stdout, proc.stdout
    assert "agent.role_pack_invalid" in proc.stdout, proc.stdout


@scenario("role_pack_not_array")
def role_pack_not_array():
    repo = fixture("rp-notarray", mutate=with_specifier_pack(
        ROLE_PACK_TEMPLATE.replace("  required:\n    - product-manager",
                                    "  required: product-manager")))
    proc, _ = run_verify(repo)
    assert_exit(proc, False)
    assert "expertise.required must be a list" in proc.stdout, proc.stdout
    assert "agent.role_pack_invalid" in proc.stdout, proc.stdout


@scenario("packs_frontmatter_valid")
def packs_frontmatter_valid():
    # Positive path: the committed packs themselves satisfy the front-matter
    # contract — every role pack prints ": ok" and verification stays green.
    repo = fixture("packs-valid")
    proc = sh("./scripts/verify-candidate", repo, check=False)
    assert proc.returncode == 0, proc.stdout + proc.stderr
    for stage in ("specifier", "coder", "cleaner", "hardener", "qa"):
        needle = "docs/agents/roles/%s.md: ok" % stage
        assert needle in proc.stdout, (needle, proc.stdout)


# --------------------------------------------------------------------------
# Task 4 scenarios: four-valued results and report v2 (design §9.1)
# --------------------------------------------------------------------------


def yaml_shim(directory):
    """PYTHONPATH shadow that makes `import yaml` fail (interpretation note 11)."""
    directory.mkdir(parents=True, exist_ok=True)
    (directory / "yaml.py").write_text(
        "raise ImportError('yaml blocked by scripts/selftest')\n", encoding="utf-8")
    return str(directory)


@scenario("report_v2_shape")
def report_v2_shape():
    repo = fixture("v2-shape", items={"FJ-900": base_item()})
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, True)
    assert report["status"] == "passed", report["status"]
    assert re.fullmatch(r"[0-9a-f]{64}", report.get("candidateFingerprint") or ""), \
        report.get("candidateFingerprint")
    assert re.fullmatch(r"[0-9a-f]{64}", report.get("taskFingerprint") or ""), \
        report.get("taskFingerprint")     # task engine lands in Task 5
    assert report.get("policy", {}).get("class") == "metadata", report.get("policy")
    for check in report["checks"]:
        missing = {"name", "gate", "required", "result", "exitCode", "code",
                   "exempted", "command"} - set(check)
        assert not missing, (check["name"], missing)
        assert check["result"] in {"pass", "fail", "skipped", "not_applicable"}, check
        assert check["gate"] in {"G-S", "G-C", "G-L", "G-H", "G-Q"}, check
        assert isinstance(check["required"], bool), check
        assert isinstance(check["exempted"], bool), check


