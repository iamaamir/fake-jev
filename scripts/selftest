    assert "C-MATCH-001" not in reason, reason   # exists in the real catalog


@scenario("evidence_unreadable_artifact")
def evidence_unreadable_artifact():
    # An existing-but-unopenable artifact is a per-stage verdict
    # (stage.evidence_invalid), never a crashed engine run: failures are
    # data, not a crashed run (:538-539), and design §7 wants a targeted row.
    repo = fixture("ev-unreadable",
                   items={"FJ-900": base_item(status="review", stage="qa")})
    fp = candidate_fp(repo)
    info = task_info_json(repo, "FJ-900")
    write_chain(repo, "FJ-900", info["requiredStages"], fp, info["taskFingerprint"])
    coder = repo / ".agent" / "work" / "FJ-900" / "coder.md"
    os.chmod(coder, 0o000)
    try:
        proc, report = run_verify(repo, task="FJ-900")
    finally:
        os.chmod(coder, 0o644)
    assert_exit(proc, False)
    expect(report, "stage.coder.header", code="stage.evidence_invalid",
           result="fail", required=True, gate="G-C")
    assert not any(c["name"] == "stage.coder.chain" for c in report["checks"]), \
        "an unreadable artifact suppresses that stage's chain row"


@scenario("evidence_duplicate_key_padded")
def evidence_duplicate_key_padded():
    # A whitespace-padded repeat of an existing key is still a duplicate: the
    # uniqueness check must run on the stripped key, otherwise a padded
    # taskFingerprint silently overwrites the recorded one (last-wins).
    repo = fixture("ev-dupkey",
                   items={"FJ-900": base_item(status="review", stage="qa")})
    fp = candidate_fp(repo)
    info = task_info_json(repo, "FJ-900")
    write_chain(repo, "FJ-900", info["requiredStages"], fp, info["taskFingerprint"])
    coder = repo / ".agent" / "work" / "FJ-900" / "coder.md"
    text = coder.read_text(encoding="utf-8")
    lines = text.split("\n")
    index = next(i for i, line in enumerate(lines)
                 if line.startswith("taskFingerprint:"))
    lines.insert(index + 1, " " + lines[index])
    coder.write_text("\n".join(lines), encoding="utf-8")
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    expect(report, "stage.coder.header", code="stage.evidence_invalid",
           result="fail", required=True, gate="G-C")
    assert not any(c["name"] == "stage.coder.task_fingerprint"
                   for c in report["checks"]), \
        "an invalid header suppresses the dependent task-fingerprint row"


# --------------------------------------------------------------------------
# Task 7 scenarios: stage applicability, tooling rows, exemption
# application and the NA seam (design §8.3, §9.1, §9.2, §9.3)
# --------------------------------------------------------------------------

def verifying_cleaner_item():
    """Metadata item whose cleaner stage is due (§8.1: verifying → up to stage)."""
    return base_item(status="verifying", stage="cleaner",
                     leaseOwner="selftest-agent")


def fingerprint_pair(repo, task_id):
    """(candidate, task) fingerprints bound to the fixture exactly as written."""
    return candidate_fp(repo), current_tfp(repo, task_id)


@scenario("required_na_invalid_result")
def required_na_invalid_result():
    repo = fixture("req-na", items={"FJ-900": base_item()})
    proc, report = run_verify(repo, task="FJ-900",
                              env={"GAUNTLET_SELFTEST_NA": "check_required_files"})
    assert_exit(proc, False)
    assert report["status"] == "failed"
    expect(report, "check_required_files", code="gate.invalid_result",
           result="fail", required=True)


@scenario("optional_na_success")
def optional_na_success():
    # product class, no go.mod yet → Go checks run non-required (note 1a),
    # so the seam can turn the skip into not_applicable without failing.
    item = base_item(allowedFiles=["testdata/golden.json"])
    repo = fixture("opt-na", items={"FJ-900": item})
    proc, report = run_verify(repo, task="FJ-900",
                              env={"GAUNTLET_SELFTEST_NA": "check_go_test"})
    assert_exit(proc, True)
    assert report["status"] == "passed"
    expect(report, "check_go_test", result="not_applicable", required=False)


@scenario("metadata_hardener_na")
def metadata_hardener_na():
    # metadata derives S, C, L, Q: Hardener is outside requiredStages, and a
    # stage outside requiredStages is never pending — ready emits it too.
    repo = fixture("meta-hardener", items={"FJ-900": base_item()})
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, True)
    assert report["status"] == "passed"
    row = expect(report, "stage.hardener.requiredness", gate="G-H",
                 result="not_applicable", required=False,
                 code="stage.not_required")
    assert "metadata" in (row["reason"] or ""), row


@scenario("exemption_tooling_bootstrap")
def exemption_tooling_bootstrap():
    item = verifying_cleaner_item()
    repo = fixture("ex-tooling", items={"FJ-900": item})
    fp, tfp = fingerprint_pair(repo, "FJ-900")
    write_chain(repo, "FJ-900", ["specifier", "coder", "cleaner", "qa"], fp, tfp)
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, True)
    assert report["status"] == "passed"
    row = expect(report, "stage.cleaner.tooling", gate="G-L",
                 result="skipped", required=True,
                 code="stage.tooling_bootstrap_exempt")
    assert row["exempted"] is True, row


@scenario("exemption_gate_mismatch")
def exemption_gate_mismatch():
    def narrow_blocks(repo):
        # Same fixture, but the G-L exemption no longer names the blocking
        # code: gate alone must not waive the row (§9.2 narrow matching).
        path = repo / ".agent" / "gate-policy.json"
        data = json.loads(path.read_text(encoding="utf-8"))
        for exemption in data["exemptions"]:
            if exemption.get("gate") == "G-L":
                exemption["blocks"] = ["stage.not_the_tooling_code"]
        path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")

    item = verifying_cleaner_item()
    repo = fixture("ex-gate", items={"FJ-900": item}, mutate=narrow_blocks)
    fp, tfp = fingerprint_pair(repo, "FJ-900")
    write_chain(repo, "FJ-900", ["specifier", "coder", "cleaner", "qa"], fp, tfp)
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    assert report["status"] == "failed"
    row = expect(report, "stage.cleaner.tooling", gate="G-L",
                 result="skipped", required=True,
                 code="stage.tooling_absent")
    assert row["exempted"] is False, row


@scenario("pyyaml_exempt_with_task")
def pyyaml_exempt_with_task():
    repo = fixture("pyyaml-exempt", items={"FJ-900": base_item()})
    shim = yaml_shim(repo.parent / "pyyaml-shim")
    proc, report = run_verify(repo, task="FJ-900", env={"PYTHONPATH": shim})
    assert_exit(proc, True)
    assert report["status"] == "passed"
    row = expect(report, "check_role_packs", code="toolchain.pyyaml_exempt",
                 result="skipped", required=True)
    assert row["exempted"] is True, row


# --------------------------------------------------------------------------
# Task 8 scenarios: verificationCommands execution (design §6.2, §8.3)
# --------------------------------------------------------------------------


@scenario("verify_command_failure")
def verify_command_failure():
    item = base_item(verificationCommands=["true", "exit 3"])
    repo = fixture("vc-fail", items={"FJ-900": item})
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    assert report["status"] == "failed", report["status"]
    expect(report, "task.verify_command[0]", result="pass",
           required=True, gate="G-C")
    expect(report, "task.verify_command[1]", code="task.verify_command_failed",
           result="fail", required=True, gate="G-C")
    assert rows(report, "task.verify_command[1]")["exitCode"] == 3


@scenario("verify_command_recursive")
def verify_command_recursive():
    item = base_item(verificationCommands=[
        "./scripts/verify-candidate > /dev/null 2>&1; touch RECURSION_PROBE"])
    repo = fixture("vc-recursive", items={"FJ-900": item})
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    expect(report, "task.verify_command[0]", code="task.verify_command_recursive",
           result="fail", required=True, gate="G-C")
    assert not (repo / "RECURSION_PROBE").exists(), \
        "recursive verification command was executed"


# --------------------------------------------------------------------------
# Task 9 scenarios: agent-context GAUNTLET and EXPERTISE views (design §10)
# --------------------------------------------------------------------------


def gauntlet_fixture(name):
    """Verifying coder-stage metadata item, chain-consistent artifacts, one
    bound report — the baseline both scenarios render against."""
    item = base_item(status="verifying", stage="coder",
                     leaseOwner="selftest-agent")
    repo = fixture(name, items={"FJ-900": item})
    fp = candidate_fp(repo)
    info = task_info_json(repo, "FJ-900")
    write_chain(repo, "FJ-900", info["requiredStages"], fp, info["taskFingerprint"])
    proc, _report = run_verify(repo, task="FJ-900")
    assert_exit(proc, True)   # gates need a bound report before we render it
    return repo, fp, info


@scenario("gauntlet_block_renders")
def gauntlet_block_renders():
    repo, fp, _info = gauntlet_fixture("gauntlet-render")
    out = sh("./scripts/agent-context FJ-900", repo).stdout
    assert re.search(r"Specifier\s+artifact: fresh\s+gate: pass", out), out
    assert re.search(r"Coder\s+artifact: fresh\s+gate: pass", out), out
    assert re.search(r"Cleaner\s+artifact: pending\s+gate: not run", out), out
    assert re.search(r"QA\s+artifact: pending\s+gate: not run", out), out
    assert re.search(r"Hardener\s+artifact: not required\s+gate: not applicable",
                     out), out
    assert "candidate: " + fp in out, out
    assert "EXPERTISE" in out and \
        "docs/agents/expertise/golang.md" in out.split("EXPERTISE", 1)[1], out
    # Task semantics changed behind the artifact's back: the coder artifact
    # records the old task fingerprint and must render stale at once (§7).
    write_artifact(repo, "FJ-900", "coder", fp, fp, "f" * 64)
    out = sh("./scripts/agent-context FJ-900", repo).stdout
    assert re.search(r"Coder\s+artifact: stale", out), out


@scenario("gauntlet_report_binding")
def gauntlet_report_binding():
    repo, _fp, _info = gauntlet_fixture("gauntlet-binding")
    # Candidate content changed after the bound report: the digest excludes
    # .agent/work and .agent/reports (writing artifacts/report did not move
    # it), but README.md does — report bound to the old fingerprint is ignored
    # in the GAUNTLET block and surfaces in EVIDENCE FRESHNESS instead (§10).
    with (repo / "README.md").open("a", encoding="utf-8") as handle:
        handle.write("\nprobe: candidate changed after the bound report\n")
    out = sh("./scripts/agent-context FJ-900", repo).stdout
    assert re.search(r"Specifier\s+artifact: fresh\s+gate: not run", out), out
    assert re.search(r"Coder\s+artifact: stale\s+gate: not run", out), out
    assert "bound to an older fingerprint" in out, out


# --------------------------------------------------------------------------
# Task 10 scenario: verificationCommands migration pin (real repository scan)
# (design §6.2 migration note)
# --------------------------------------------------------------------------

@scenario("verification_commands_never_recurse")
def verification_commands_never_recurse():
    # Real repository items (read-only scan): verificationCommands must never
    # invoke the verifier itself — the gauntlet already runs (design §6.2, §8.3).
    bad = []
    for path in sorted((REAL / ".agent" / "work").glob("*/state.json")):
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except ValueError:
            continue
        for entry in data.get("verificationCommands") or []:
            if not isinstance(entry, str) or "scripts/verify-candidate" in entry:
                bad.append("%s: %r" % (path.parent.name, entry))
    assert not bad, "pointer entries must be re-seeded to []: %s" % bad


# --------------------------------------------------------------------------
# FJ-052 scenarios: status history, recorded-report coverage, author
# attribution and role separation (design §7, §8.4, §8.5; §12 matrix rows)
# --------------------------------------------------------------------------


@scenario("history_missing_or_edge_violation")
def history_missing_or_edge_violation():
    # (a) a non-grandfathered item without statusHistory fails the repo-scoped
    # schema check on a task-less run.
    missing = base_item()
    missing.pop("statusHistory")
    repo = fixture("hist-missing", items={"FJ-900": missing})
    proc = sh("./scripts/verify-candidate", repo, check=False)
    assert_exit(proc, False)
    assert "statusHistory missing" in proc.stdout, proc.stdout
    assert "agent.work_item_schema" in proc.stdout, proc.stdout

    # (b) acceptance canary: a recorded implementing -> complete jump skips
    # verifying/review, which the §8.4 edge table never permits.
    bad = base_item(status="complete",
                    statusHistory=["planned", "ready", "implementing",
                                   "complete"])
    repo = fixture("hist-bad-edge", items={"FJ-900": bad})
    # Valid recorded coverage so this run fails on the history rule alone.
    rel = write_fixture_report(repo, "FJ-900",
                               ["specifier", "coder", "cleaner", "qa"])
    attach_last_verification(repo, "FJ-900", rel)
    proc = sh("./scripts/verify-candidate", repo, check=False)
    assert_exit(proc, False)
    assert ("statusHistory pair 'implementing->complete' not an allowed "
            "transition") in proc.stdout, proc.stdout
    assert "agent.work_item_schema" in proc.stdout, proc.stdout
    assert "policy.last_verification_coverage" not in proc.stdout, proc.stdout


@scenario("coverage_missing_terminal_row")
def coverage_missing_terminal_row():
    # A complete non-grandfathered item whose recorded report lacks the last
    # required stage's terminal row fails the coverage check (§7).
    item = base_item(status="complete")
    repo = fixture("cov-terminal", items={"FJ-900": item})
    rel = write_fixture_report(repo, "FJ-900",
                               ["specifier", "coder", "cleaner", "qa"],
                               omit={"stage.qa.terminal"})
    attach_last_verification(repo, "FJ-900", rel)
    proc = sh("./scripts/verify-candidate", repo, check=False)
    assert_exit(proc, False)
    assert "policy.last_verification_coverage" in proc.stdout, proc.stdout
    assert "missing report row stage.qa.terminal" in proc.stdout, proc.stdout
    assert "agent.work_item_schema" not in proc.stdout, proc.stdout


@scenario("author_missing_on_due_artifact")
def author_missing_on_due_artifact():
    item = base_item(status="implementing", stage="coder",
                     leaseOwner="selftest-agent")
    repo = fixture("auth-missing", items={"FJ-900": item})
    fp = candidate_fp(repo)
    info = task_info_json(repo, "FJ-900")
    write_chain(repo, "FJ-900", info["requiredStages"], fp, info["taskFingerprint"])
    spec = repo / ".agent" / "work" / "FJ-900" / "specifier.md"
    spec.write_text(spec.read_text(encoding="utf-8")
                    .replace("author: selftest/specifier\n", ""),
                    encoding="utf-8")
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    row = expect(report, "stage.specifier.author", code="stage.evidence_invalid",
                 result="fail", required=True, gate="G-S")
    assert "author" in (row["reason"] or ""), row
    # Attribution is the only defect: the remaining evidence rows pass.
    expect(report, "stage.specifier.header", result="pass")
    expect(report, "stage.specifier.task_fingerprint", result="pass")


@scenario("author_overlap_qa_equals_coder")
def author_overlap_qa_equals_coder():
    item = base_item(status="review", stage="qa")
    repo = fixture("auth-overlap", items={"FJ-900": item})
    fp = candidate_fp(repo)
    info = task_info_json(repo, "FJ-900")
    write_chain(repo, "FJ-900", info["requiredStages"], fp, info["taskFingerprint"])
    for stage in ("coder", "qa"):
        path = repo / ".agent" / "work" / "FJ-900" / ("%s.md" % stage)
        text = path.read_text(encoding="utf-8")
        needle = "author: selftest/%s\n" % stage
        assert needle in text, text
        path.write_text(text.replace(needle, "author: selftest/shared\n"),
                        encoding="utf-8")
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    expect(report, "policy.author_overlap", code="policy.author_overlap",
           result="fail", required=True, gate="G-C")
    expect(report, "stage.coder.author", result="pass", required=True)
    expect(report, "stage.qa.author", result="pass", required=True)
    expect(report, "stage.qa.terminal", result="pass")


# --- runner ---
# Scenario groups from later tasks are inserted ABOVE this line so they are
# registered before the run starts.

def main(argv):
    # Fail closed: -O / PYTHONOPTIMIZE strips every scenario `assert`, so an
    # optimized run would report success while checking nothing.
    if not __debug__:
        print("selftest: refusing to run under optimization "
              "(python -O / PYTHONOPTIMIZE strips assert checks); "
              "rerun without optimization", file=sys.stderr)
        return 1
    filters = argv[1:]
    selected = [(name, fn) for name, fn in SCENARIOS
                if not filters or any(f in name for f in filters)]
    if not selected:
        print("no scenarios match: %s" % " ".join(filters), file=sys.stderr)
        return 2
    passed = failed = 0
    for name, fn in selected:
        try:
            fn()
        except Exception:
            failed += 1
            print("FAIL %s" % name)
            traceback.print_exc()
        else:
            passed += 1
            print("PASS %s" % name)
    print("summary: %d passed, %d failed" % (passed, failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
