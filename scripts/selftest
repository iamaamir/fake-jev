@scenario("exemption_unknown_trackedby")
def exemption_unknown_trackedby():
    def bad_policy(repo):
        (repo / ".agent" / "gate-policy.json").write_text(json.dumps({
            "exemptions": [{
                "gate": "G-L", "blocks": ["stage.tooling_absent"],
                "scope": ["product"], "code": "stage.tooling_bootstrap_exempt",
                "reason": "fixture", "trackedBy": "FJ-404"}]}) + "\n",
            encoding="utf-8")
    repo = fixture("ex-unknown", items={"FJ-900": base_item()}, mutate=bad_policy)
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    expect(report, "policy.exemptions.unknown", code="policy.exemption_unknown",
           result="fail", required=True)


@scenario("exemption_stale_trackedby")
def exemption_stale_trackedby():
    def complete_tracker(repo):
        # Compliant completion fixture: history ending `complete` (§8.4) and a
        # recorded report covering every required stage row (§7), so the run
        # fails on the stale exemption alone.
        path = repo / ".agent" / "work" / "FJ-044" / "state.json"
        state = json.loads(path.read_text(encoding="utf-8"))
        state["status"] = "complete"
        state["statusHistory"] = list(HISTORY_PATHS["complete"])
        path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n",
                        encoding="utf-8")
        rel = write_fixture_report(repo, "FJ-044",
                                   ["specifier", "coder", "cleaner", "qa"])
        attach_last_verification(repo, "FJ-044", rel)

    repo = fixture("ex-stale", items={"FJ-900": base_item()}, mutate=complete_tracker)
    proc, report = run_verify(repo, task="FJ-900")
    assert_exit(proc, False)
    expect(report, "policy.exemptions.stale", code="policy.exemption_stale",
           result="fail", required=True)
    expect(report, "check_work_item_schema", result="pass", required=True)
    expect(report, "check_recorded_report_coverage", result="pass",
           required=True)


