def with_go_module(repo):
    (repo / "go.mod").write_text("module fixture.example\n\ngo 1.21\n",
                                 encoding="utf-8")
    main = repo / "cmd" / "fake-jev"
    main.mkdir(parents=True)
    (main / "main.go").write_text("package main\n\nfunc main() {}\n",
                                  encoding="utf-8")
    pkg = repo / "internal" / "sample"
    pkg.mkdir(parents=True)
    (pkg / "sample.go").write_text(
        "package sample\n\nfunc Value() int { return 1 }\n", encoding="utf-8")


