                   items={"FJ-900": base_item(status="review", stage="qa")})
    fp = candidate_fp(repo)
    info = task_info_json(repo, "FJ-900")
    write_chain(repo, "FJ-900", info["requiredStages"], fp, info["taskFingerprint"],
                body="## Traces\n\n- C-MATCH-001\n- C-NOPE-999")
    proc, report = run_verify(repo, task="FJ-900")
