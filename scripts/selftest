           result="fail", required=True, gate="G-C")


@scenario("required_skipped_failure")
def required_skipped_failure():
    # Task 3's committed gate-policy waives toolchain.pyyaml_missing, so §12's
    # "required + skipped → failure" row needs a policy without exemptions.
    # {"exemptions": []} still passes policy.exemptions.* (count 0).
    def empty_gate_policy(repo):
        (repo / ".agent" / "gate-policy.json").write_text(
            json.dumps({"exemptions": []}) + "\n", encoding="utf-8")

    repo = fixture("req-skip", items={"FJ-900": base_item()},
                   mutate=empty_gate_policy)
    shim = yaml_shim(repo.parent / "pyyaml-shim")
    proc, report = run_verify(repo, task="FJ-900", env={"PYTHONPATH": shim})
    assert_exit(proc, False)
    assert report["status"] == "failed"
    expect(report, "check_role_packs", code="toolchain.pyyaml_missing",
           result="skipped", required=True)
    assert rows(report, "check_role_packs")["exempted"] is False


