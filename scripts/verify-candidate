#!/usr/bin/env bash
# verify-candidate [task-id]
#
# Deterministic verification entry point for this repository. Offline: no network,
# no model/provider calls, no services. Prints each check it runs and exits non-zero
# if any mandatory check fails.
#
# With a task id, structured evidence is written to
# .agent/reports/<task-id>/report-<utc-timestamp>.json, bound to the revision that
# was verified (null when Git metadata is unavailable).
#
# PRODUCT VERIFICATION EXPANDS HERE: as implementation phases land, add the product
# checks centrally (e.g. `go test ./...`, `go vet ./...`, `go build ./cmd/fake-jev`
# once go.mod exists, then contract/integration checks defined by the specification).
# Do not fork per-task verification scripts. Checks that cannot apply yet are
# reported as "skipped", never as a silent pass.
#
# Exit codes: 0 = all mandatory checks passed; 1 = a check failed or usage/state error.

set -euo pipefail

usage() {
  echo "usage: $0 [task-id]" >&2
  exit 1
}

[ "$#" -le 1 ] || usage
TASK_ID="${1:-}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

REVISION="unknown"
GIT_AVAILABLE=0
if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
  GIT_AVAILABLE=1
  REVISION="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
fi

# Tree state: evidence bound to HEAD is only meaningful when the worktree matches
# it. Report, do not assume — verifying a dirty tree is legitimate, but the report
# must say so.
TREE_KNOWN=0
TREE_CLEAN=null
TREE_STAGED=0
TREE_UNSTAGED=0
TREE_UNTRACKED=0
if [ "$GIT_AVAILABLE" -eq 1 ]; then
  TREE_KNOWN=1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    x="${line:0:1}"
    y="${line:1:1}"
    if [ "$x" = "?" ] && [ "$y" = "?" ]; then
      TREE_UNTRACKED=$((TREE_UNTRACKED + 1))
      continue
    fi
    if [ "$x" != " " ]; then
      TREE_STAGED=$((TREE_STAGED + 1))
    fi
    if [ "$y" != " " ]; then
      TREE_UNSTAGED=$((TREE_UNSTAGED + 1))
    fi
  done < <(git status --porcelain 2>/dev/null || true)
  if [ "$TREE_STAGED" -eq 0 ] && [ "$TREE_UNSTAGED" -eq 0 ] && [ "$TREE_UNTRACKED" -eq 0 ]; then
    TREE_CLEAN=true
  else
    TREE_CLEAN=false
  fi
fi

GIT_JSON=false
if [ "$GIT_AVAILABLE" -eq 1 ]; then
  GIT_JSON=true
fi

CHECK_NAMES=()
CHECK_CMDS=()
CHECK_STATUS=()
CHECK_EXITS=()
CHECK_CODES=()
FAILED=0
SKIPPED=0

# Stable machine code per check. Reports carry it so a failure is data, not prose:
# agents fingerprint repeated failures from code + check name instead of scraping
# stderr (spec-independent house rule, see docs/development/agent-workflow.md).
check_code() {
  case "$1" in
    check_required_files)      echo "repo.required_files_missing" ;;
    check_scripts_executable)  echo "repo.scripts_not_executable" ;;
    check_shell_syntax)        echo "shell.syntax_error" ;;
    check_toolchain_python3)   echo "toolchain.python3_missing" ;;
    check_spec_present)        echo "spec.missing" ;;
    check_json_files)          echo "agent.json_malformed" ;;
    check_work_item_schema)    echo "agent.work_item_schema" ;;
    check_role_packs)          echo "agent.role_pack_invalid" ;;
    check_go_test)             echo "go.test_failed" ;;
    check_go_vet)              echo "go.vet_failed" ;;
    check_go_build)            echo "go.build_failed" ;;
    *)                         echo "verify.check_failed" ;;
  esac
}

# run_check <display> <function> — runs the check function in a subshell so that a
# failing `exit` inside a check cannot abort the whole verification run.
run_check() {
  local display="$1" fn="$2" rc code
  code="$(check_code "$fn")"
  printf '==> %s\n' "$display"
  set +e
  ( "$fn" )
  rc=$?
  set -e
  CHECK_NAMES+=("$fn")
  CHECK_CMDS+=("$display")
  CHECK_EXITS+=("$rc")
  CHECK_CODES+=("$code")
  if [ "$rc" -eq 0 ]; then
    CHECK_STATUS+=("passed")
    printf '    PASS\n\n'
  else
    CHECK_STATUS+=("failed")
    FAILED=$((FAILED + 1))
    printf '    FAIL (exit %s, code %s)\n\n' "$rc" "$code"
  fi
}

skip_check() {
  local display="$1" fn="$2" reason="$3" explicit_code="${4:-}"
  printf '==> %s\n    SKIPPED: %s\n\n' "$display" "$reason"
  CHECK_NAMES+=("$fn")
  CHECK_CMDS+=("$display")
  CHECK_STATUS+=("skipped")
  CHECK_EXITS+=("-1")
  CHECK_CODES+=("${explicit_code:-$(check_code "$fn")}")
  SKIPPED=$((SKIPPED + 1))
}

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

echo "verify-candidate: repository=$REPO_ROOT revision=$REVISION"
if [ "$TREE_KNOWN" -eq 1 ]; then
  if [ "$TREE_CLEAN" = "true" ]; then
    echo "verify-candidate: tree clean"
  else
    echo "verify-candidate: tree DIRTY ($TREE_STAGED staged, $TREE_UNSTAGED unstaged, $TREE_UNTRACKED untracked) — evidence is bound to $REVISION plus these changes"
  fi
else
  echo "verify-candidate: tree state unknown (no git metadata)"
fi
if [ -n "$TASK_ID" ]; then
  echo "verify-candidate: task=$TASK_ID"
fi
echo

if [ -n "$TASK_ID" ] && [ ! -f ".agent/work/$TASK_ID/state.json" ]; then
  echo "ERROR: no work item at .agent/work/$TASK_ID/state.json" >&2
  exit 1
fi

# --- foundation checks -------------------------------------------------------

check_required_files() {
  local missing=0 f
  for f in README.md AGENTS.md .gitignore spec/README.md \
           spec/fake-jev-technical-spec-v2.md docs/development/agent-workflow.md \
           docs/adr/README.md .agent/README.md \
           scripts/agent-context scripts/verify-candidate \
           scripts/candidate-fingerprint scripts/selftest \
           docs/agents/README.md .agent/gate-policy.json \
           .agent/schema/role-pack.schema.json \
           .agent/schema/stage-artifact.schema.json \
           .agent/schema/work-item.schema.json; do
    if [ ! -f "$f" ]; then
      echo "missing: $f"
      missing=1
    fi
  done
  return "$missing"
}
run_check "required repository files exist" check_required_files

check_scripts_executable() {
  local missing=0 s
  for s in scripts/agent-context scripts/verify-candidate \
           scripts/candidate-fingerprint scripts/selftest; do
    if [ ! -x "$s" ]; then
      echo "not executable: $s"
      missing=1
    fi
  done
  return "$missing"
}
run_check "scripts are executable" check_scripts_executable

check_shell_syntax() {
  bash -n scripts/verify-candidate && bash -n scripts/agent-context
}
run_check "shell syntax: bash -n scripts/*" check_shell_syntax

check_toolchain_python3() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found (required by scripts/agent-context)"
    return 1
  fi
  echo "python3: $(command -v python3)"
}
run_check "toolchain: python3 available" check_toolchain_python3

check_spec_present() {
  local spec="spec/fake-jev-technical-spec-v2.md"
  if [ ! -s "$spec" ]; then
    echo "missing or empty: $spec"
    return 1
  fi
  if ! grep -q '^## 0\. Normative status' "$spec"; then
    echo "spec does not look intact (missing section 0 header): $spec"
    return 1
  fi
  echo "spec present: $spec ($(wc -c < "$spec" | tr -d ' ') bytes)"
}
run_check "authoritative spec present and intact" check_spec_present

check_json_files() {
  local bad=0 f
  for f in $(find .agent -name '*.json' -type f | sort); do
    if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null; then
      echo "malformed JSON: $f"
      bad=1
    fi
  done
  if [ "$bad" -eq 0 ]; then
    echo "all .agent JSON files parse"
  fi
  return "$bad"
}
run_check "all .agent JSON files parse" check_json_files

check_work_item_schema() {
  python3 - <<'PY'
import json, pathlib, sys

REQUIRED = ["id", "title", "phase", "objective", "status", "acceptance",
            "allowedFiles", "verificationCommands", "nextAction"]
STATUSES = {"planned", "ready", "implementing", "verifying", "review",
            "blocked", "complete"}
LISTS = ["specReferences", "relevantFiles", "allowedFiles", "acceptance",
         "nonGoals", "verificationCommands", "notes"]
# Active execution must be leased: two agents sharing one tree need to know who
# owns a work item. Verification fails closed on a missing or contended lease.
LEASE_REQUIRED = {"implementing", "verifying"}

failed = False
paths = sorted(pathlib.Path(".agent/work").glob("*/state.json"))
if not paths:
    print("no work items found (ok during foundation phase)")
claims = {}
for p in paths:
    try:
        data = json.loads(p.read_text())
    except Exception as exc:
        print(f"{p}: malformed: {exc}")
        failed = True
        continue
    problems = []
    for key in REQUIRED:
        if key not in data:
            problems.append(f"missing field: {key}")
    if data.get("id") != p.parent.name:
        problems.append(f"id {data.get('id')!r} does not match directory {p.parent.name!r}")
    if data.get("status") not in STATUSES:
        problems.append(f"status {data.get('status')!r} not in vocabulary")
    for key in LISTS:
        if key in data and not isinstance(data[key], list):
            problems.append(f"{key} must be a list")
    lease = data.get("leaseOwner")
    if lease is not None and (not isinstance(lease, str) or not lease.strip()):
        problems.append("leaseOwner must be a non-empty string or null")
    elif isinstance(lease, str) and lease.strip():
        claims.setdefault(lease.strip(), []).append(p.parent.name)
    if data.get("status") in LEASE_REQUIRED and not (isinstance(lease, str) and lease.strip()):
        problems.append(f"status {data.get('status')!r} requires a non-empty leaseOwner")
    if problems:
        failed = True
        print(f"{p}:")
        for problem in problems:
            print(f"  - {problem}")
    else:
        print(f"{p}: ok")
for owner in sorted(claims):
    holders = claims[owner]
    if len(holders) > 1:
        failed = True
        print(f"lease conflict: {owner!r} claimed by {', '.join(holders)}")
sys.exit(1 if failed else 0)
PY
}
run_check "work items match the state.json schema" check_work_item_schema

check_role_packs() {
  python3 - <<'PY'
import pathlib
import re
import sys

import yaml

STAGES = ["specifier", "coder", "cleaner", "hardener", "qa"]
GATES = {"specifier": "G-S", "coder": "G-C", "cleaner": "G-L",
         "hardener": "G-H", "qa": "G-Q"}
BLOCKERS = {"spec-gap", "needs-info", "needs-human", "wontfix"}
ALLOWED_KEYS = {"id", "stage", "expertise", "inputs", "output", "gate", "escalate"}
EXPERTISE_DIR = pathlib.Path("docs/agents/expertise")

failed = False
packs = sorted(pathlib.Path("docs/agents/roles").glob("*.md"))
if not packs:
    print("no role packs found at docs/agents/roles/")
    sys.exit(1)
for path in packs:
    problems = []
    text = path.read_text(encoding="utf-8")
    match = re.match(r"^---\n(.*?)\n---\n", text, re.S)
    data = {}
    if not match:
        problems.append("missing YAML front matter")
    else:
        try:
            loaded = yaml.safe_load(match.group(1))
        except yaml.YAMLError as exc:
            problems.append(f"unparseable front matter: {exc}")
            loaded = None
        if isinstance(loaded, dict):
            data = loaded
        elif loaded is not None:
            problems.append("front matter is not a mapping")
    if data:
        for key in sorted(set(data) - ALLOWED_KEYS):
            problems.append(f"unknown front-matter key: {key}")
        for key in sorted(ALLOWED_KEYS - set(data)):
            problems.append(f"missing front-matter key: {key}")
        sid, stage = data.get("id"), data.get("stage")
        if stage not in STAGES:
            problems.append(f"stage {stage!r} not in vocabulary")
        if sid is not None and sid != stage:
            problems.append(f"id {sid!r} != stage {stage!r}")
        if stage in GATES and data.get("gate") != GATES[stage]:
            problems.append(f"gate {data.get('gate')!r} != {GATES[stage]!r} for stage {stage!r}")
        if data.get("output") != ".agent/work/<id>/<stage>.md":
            problems.append(f"output {data.get('output')!r} != '.agent/work/<id>/<stage>.md'")
        expertise = data.get("expertise")
        req, opt = [], []
        if not isinstance(expertise, dict):
            problems.append("expertise must be a mapping")
        else:
            for kind in ("required", "optional"):
                value = expertise.get(kind)
                if not isinstance(value, list):
                    problems.append(f"expertise.{kind} must be a list (even when empty)")
                elif any(not isinstance(item, str) for item in value):
                    problems.append(f"expertise.{kind} entries must be strings")
                elif len(value) != len(set(value)):
                    problems.append(f"expertise.{kind} has duplicates")
            if isinstance(expertise.get("required"), list):
                req = expertise["required"]
            if isinstance(expertise.get("optional"), list):
                opt = expertise["optional"]
            for name in sorted(set(req) | set(opt)):
                if not (EXPERTISE_DIR / f"{name}.md").is_file():
                    problems.append(f"dangling expertise reference: {name}")
            overlap = sorted(set(req) & set(opt))
            if overlap:
                problems.append(f"expertise required and optional overlap: {overlap}")
        inputs = data.get("inputs")
        if not isinstance(inputs, list) or any(not isinstance(x, str) for x in inputs):
            problems.append("inputs must be a list of strings")
        escalate = data.get("escalate")
        if not isinstance(escalate, list):
            problems.append("escalate must be a list")
        else:
            for index, entry in enumerate(escalate):
                if not isinstance(entry, dict) or set(entry) != {"condition", "blocker"}:
                    problems.append(f"escalate[{index}] must be exactly {{condition, blocker}}")
                    continue
                if entry.get("blocker") not in BLOCKERS:
                    problems.append(f"escalate[{index}].blocker {entry.get('blocker')!r} not in vocabulary")
                if not isinstance(entry.get("condition"), str) or not entry.get("condition").strip():
                    problems.append(f"escalate[{index}].condition must be a non-empty string")
    else:
        failed = True
        print(f"{path}:")
        for problem in problems:
            print(f"  - {problem}")
        continue
    if problems:
        failed = True
        print(f"{path}:")
        for problem in problems:
            print(f"  - {problem}")
    else:
        print(f"{path}: ok")
named = {pack.stem for pack in packs}
for stage in STAGES:
    if stage not in named:
        failed = True
        print(f"missing role pack: docs/agents/roles/{stage}.md")
sys.exit(1 if failed else 0)
PY
}
if python3 -c 'import yaml' >/dev/null 2>&1; then
  run_check "role packs match the role-pack contract" check_role_packs
else
  skip_check "role packs match the role-pack contract" check_role_packs \
    "PyYAML not importable (design §4 conditional)" "toolchain.pyyaml_missing"
fi

# --- product checks (activated as phases land) -------------------------------

# Repository-owned packages only. Tool-managed skill installs live inside the
# module but are gitignored; their sample .go files are not part of this
# repository's verification. Anything else that fails to load must fail loudly.
NON_REPO_DIRS="agent .agents .claude .pi .scratch"

repo_packages() {
  local import_path dir rel excluded=0 line
  while IFS= read -r line; do
    import_path="${line%% *}"
    dir="${line#* }"
    if [ -z "$import_path" ] || [ "$dir" = "$line" ]; then
      printf '%s\n' "$line" >&2
      continue
    fi
    rel="${dir#"$REPO_ROOT"/}"
    for skip in $NON_REPO_DIRS; do
      case "$rel" in
        "$skip"|"$skip"/*)
          excluded=$((excluded + 1))
          continue 2 ;;
      esac
    done
    printf '%s\n' "$import_path"
  done < <(go list -e -f '{{.ImportPath}} {{.Dir}}' ./... 2>&1)
  if [ "$excluded" -gt 0 ]; then
    echo "verify-candidate: excluded $excluded package(s) under gitignored tool dirs ($NON_REPO_DIRS)" >&2
  fi
}

check_go_test() {
  local pkgs
  pkgs="$(repo_packages | tr '\n' ' ')"
  if [ -z "${pkgs// /}" ]; then
    echo "no repository Go packages discovered"
    return 1
  fi
  go test $pkgs
}

check_go_vet() {
  local pkgs
  pkgs="$(repo_packages | tr '\n' ' ')"
  if [ -z "${pkgs// /}" ]; then
    echo "no repository Go packages discovered"
    return 1
  fi
  go vet $pkgs
}

check_go_build() { go build ./cmd/fake-jev; }

if [ -f go.mod ]; then
  run_check "go test (repository packages)" check_go_test
  run_check "go vet (repository packages)" check_go_vet
  if [ -d cmd/fake-jev ]; then
    run_check "go build ./cmd/fake-jev" check_go_build
  else
    skip_check "go build ./cmd/fake-jev" check_go_build "cmd/fake-jev does not exist yet"
  fi
else
  skip_check "go test (repository packages)" check_go_test "no go.mod yet (foundation phase)"
  skip_check "go vet (repository packages)" check_go_vet "no go.mod yet (foundation phase)"
  skip_check "go build ./cmd/fake-jev" check_go_build "no go.mod yet (foundation phase)"
fi

# --- report ------------------------------------------------------------------

if [ -n "$TASK_ID" ]; then
  REPORT_DIR=".agent/reports/$TASK_ID"
  mkdir -p "$REPORT_DIR"
  REPORT_PATH="$REPORT_DIR/report-$(date -u +%Y%m%dT%H%M%SZ).json"
  STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

  OVERALL="passed"
  if [ "$FAILED" -ne 0 ]; then
    OVERALL="failed"
  fi

  {
    printf '{\n'
    printf '  "taskId": "%s",\n' "$(json_escape "$TASK_ID")"
    printf '  "revision": "%s",\n' "$(json_escape "$REVISION")"
    printf '  "treeState": {"gitAvailable": %s, "clean": %s, "staged": %s, "unstaged": %s, "untracked": %s},\n' \
      "$GIT_JSON" "$TREE_CLEAN" "$TREE_STAGED" "$TREE_UNSTAGED" "$TREE_UNTRACKED"
    printf '  "startedAt": "%s",\n' "$STARTED_AT"
    printf '  "finishedAt": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '  "status": "%s",\n' "$OVERALL"
    printf '  "checks": [\n'
    for i in "${!CHECK_NAMES[@]}"; do
      if [ "$i" -gt 0 ]; then
        printf ',\n'
      fi
      exit_json="${CHECK_EXITS[$i]}"
      if [ "$exit_json" = "-1" ]; then
        exit_json="null"
      fi
      printf '    {"name": "%s", "command": "%s", "status": "%s", "exitCode": %s, "code": "%s"}' \
        "$(json_escape "${CHECK_NAMES[$i]}")" \
        "$(json_escape "${CHECK_CMDS[$i]}")" \
        "${CHECK_STATUS[$i]}" \
        "$exit_json" \
        "$(json_escape "${CHECK_CODES[$i]}")"
    done
    printf '\n  ]\n}\n'
  } > "$REPORT_PATH"
  echo "report: $REPORT_PATH"
fi

PASSED=$(( ${#CHECK_NAMES[@]} - FAILED - SKIPPED ))
echo
echo "summary: $PASSED passed, $FAILED failed, $SKIPPED skipped (revision $REVISION)"
if [ "$FAILED" -ne 0 ]; then
  echo "RESULT: FAIL"
  exit 1
fi
echo "RESULT: PASS"
exit 0
