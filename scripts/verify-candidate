#!/usr/bin/env bash
# verify-candidate [task-id]
#
# Deterministic verification entry point for this repository. Offline: no network,
# no model/provider calls, no services. Prints each check it runs.
#
# Every check is a row {name, gate, required, result, exitCode, code, exempted}
# with result in {pass, fail, skipped, not_applicable} (design §9.1). The run is
# acceptable iff no required row is `fail` or a non-exempt `skipped`, and no
# required row is invalidly `not_applicable` (rewritten to gate.invalid_result).
#
# With a task id, structured evidence is written to
# .agent/reports/<task-id>/report-<utc-timestamp>.json, bound to the candidate
# fingerprint and — once the task engine lands — the task fingerprint.
#
# PRODUCT VERIFICATION EXPANDS HERE: as implementation phases land, add the product
# checks centrally (e.g. `go test ./...`, `go vet ./...`, `go build ./cmd/fake-jev`
# once go.mod exists, then contract/integration checks defined by the specification).
# Do not fork per-task verification scripts. Checks that cannot apply yet are
# reported as "skipped", never as a silent pass.
#
# Exit codes: 0 = acceptable; 1 = a required check is fail/skipped-without-exemption,
# or a usage/state error.

set -euo pipefail

usage() {
  echo "usage: $0 [task-id]" >&2
  exit 1
}

[ "$#" -le 1 ] || usage
TASK_ID="${1:-}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

REVISION="unknown"
GIT_AVAILABLE=0
if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then
  GIT_AVAILABLE=1
  REVISION="$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
fi

# Tree state: evidence bound to HEAD is only meaningful when the worktree matches
# it. Report, do not assume — verifying a dirty tree is legitimate, but the report
# must say so.
TREE_KNOWN=0
TREE_CLEAN=null
TREE_STAGED=0
TREE_UNSTAGED=0
TREE_UNTRACKED=0
if [ "$GIT_AVAILABLE" -eq 1 ]; then
  TREE_KNOWN=1
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    x="${line:0:1}"
    y="${line:1:1}"
    if [ "$x" = "?" ] && [ "$y" = "?" ]; then
      TREE_UNTRACKED=$((TREE_UNTRACKED + 1))
      continue
    fi
    if [ "$x" != " " ]; then
      TREE_STAGED=$((TREE_STAGED + 1))
    fi
    if [ "$y" != " " ]; then
      TREE_UNSTAGED=$((TREE_UNSTAGED + 1))
    fi
  done < <(git status --porcelain 2>/dev/null || true)
  if [ "$TREE_STAGED" -eq 0 ] && [ "$TREE_UNSTAGED" -eq 0 ] && [ "$TREE_UNTRACKED" -eq 0 ]; then
    TREE_CLEAN=true
  else
    TREE_CLEAN=false
  fi
fi

GIT_JSON=false
if [ "$GIT_AVAILABLE" -eq 1 ]; then
  GIT_JSON=true
fi

# --- check row infrastructure -------------------------------------------------

CHECK_NAMES=()
CHECK_CMDS=()
CHECK_GATES=()
CHECK_REQUIRED=()
CHECK_RESULTS=()
CHECK_EXITS=()
CHECK_CODES=()
CHECK_EXEMPTED=()
CHECK_REASONS=()

# record_row <name> <display> <gate> <required 0/1> <result> <exit> <code> <reason>
# One row per check; the report writer (python) turns these into report v2 and
# computes the overall status. display/reason are flattened to one line so the
# TSV hand-off stays unambiguous.
record_row() {
  local name="$1" display="$2" gate="$3" required="$4" result="$5"
  local exit_code="$6" code="$7" reason="$8"
  display="${display//$'\t'/ }"
  display="${display//$'\n'/ }"
  reason="${reason//$'\t'/ }"
  reason="${reason//$'\n'/ }"
  CHECK_NAMES+=("$name")
  CHECK_CMDS+=("$display")
  CHECK_GATES+=("$gate")
  CHECK_REQUIRED+=("$required")
  CHECK_RESULTS+=("$result")
  CHECK_EXITS+=("$exit_code")
  CHECK_CODES+=("$code")
  CHECK_EXEMPTED+=("0")
  CHECK_REASONS+=("$reason")
}

# Stable machine code per check. Reports carry it so a failure is data, not prose:
# agents fingerprint repeated failures from code + check name instead of scraping
# stderr (spec-independent house rule, see docs/development/agent-workflow.md).
check_code() {
  case "$1" in
    check_required_files)      echo "repo.required_files_missing" ;;
    check_scripts_executable)  echo "repo.scripts_not_executable" ;;
    check_shell_syntax)        echo "shell.syntax_error" ;;
    check_toolchain_python3)   echo "toolchain.python3_missing" ;;
    check_spec_present)        echo "spec.missing" ;;
    check_json_files)          echo "agent.json_malformed" ;;
    check_work_item_schema)    echo "agent.work_item_schema" ;;
    check_role_packs)          echo "agent.role_pack_invalid" ;;
    check_go_test)             echo "go.test_failed" ;;
    check_go_vet)              echo "go.vet_failed" ;;
    check_go_build)            echo "go.build_failed" ;;
    *)                         echo "verify.check_failed" ;;
  esac
}

# run_check <display> <function> [required=1] [gate=G-C] — runs the check
# function in a subshell so that a failing `exit` inside a check cannot abort
# the whole verification run.
run_check() {
  local display="$1" fn="$2" required="${3:-1}" gate="${4:-G-C}" rc code result
  code="$(check_code "$fn")"
  printf '==> %s\n' "$display"
  set +e
  ( "$fn" )
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    result="pass"
    printf '    PASS\n\n'
  else
    result="fail"
    printf '    FAIL (exit %s, code %s)\n\n' "$rc" "$code"
  fi
  record_row "$fn" "$display" "$gate" "$required" "$result" "$rc" "$code" ""
}

# skip_check <display> <function> <reason> [code] [required=1] [gate=G-C]
skip_check() {
  local display="$1" fn="$2" reason="$3" code="${4:-}" required="${5:-1}" gate="${6:-G-C}"
  if [ -z "$code" ]; then
    code="$(check_code "$fn")"
  fi
  printf '==> %s\n    SKIPPED: %s\n\n' "$display" "$reason"
  record_row "$fn" "$display" "$gate" "$required" "skipped" "-1" "$code" "$reason"
}

# na_check <display> <function> <code> <reason> [required=0] [gate=G-C]
na_check() {
  local display="$1" fn="$2" code="$3" reason="$4" required="${5:-0}" gate="${6:-G-C}"
  printf '==> %s\n    NOT APPLICABLE: %s\n\n' "$display" "$reason"
  record_row "$fn" "$display" "$gate" "$required" "not_applicable" "-1" "$code" "$reason"
}

echo "verify-candidate: repository=$REPO_ROOT revision=$REVISION"
if [ "$TREE_KNOWN" -eq 1 ]; then
  if [ "$TREE_CLEAN" = "true" ]; then
    echo "verify-candidate: tree clean"
  else
    echo "verify-candidate: tree DIRTY ($TREE_STAGED staged, $TREE_UNSTAGED unstaged, $TREE_UNTRACKED untracked) — evidence is bound to $REVISION plus these changes"
  fi
else
  echo "verify-candidate: tree state unknown (no git metadata)"
fi
if [ -n "$TASK_ID" ]; then
  echo "verify-candidate: task=$TASK_ID"
fi
echo

if [ -n "$TASK_ID" ] && [ ! -f ".agent/work/$TASK_ID/state.json" ]; then
  echo "ERROR: no work item at .agent/work/$TASK_ID/state.json" >&2
  exit 1
fi

# --- candidate fingerprint ----------------------------------------------------

FP_ERR="$(mktemp)"
CAND_FP=""
set +e
CAND_FP_RAW="$(./scripts/candidate-fingerprint candidate 2>"$FP_ERR")"
FP_RC=$?
set -e
if [ "$FP_RC" -eq 0 ] && [[ "$CAND_FP_RAW" =~ ^[0-9a-f]{64}$ ]]; then
  CAND_FP="$CAND_FP_RAW"
  printf '==> candidate fingerprint computed\n    PASS\n\n'
  record_row "check_candidate_fingerprint" "candidate fingerprint computed" \
    "G-C" 1 "pass" 0 "verify.check_failed" ""
else
  FP_REASON="$(tr '\n' ' ' < "$FP_ERR")"
  printf '==> candidate fingerprint computed\n    FAIL (code verify.check_failed)\n\n'
  record_row "check_candidate_fingerprint" "candidate fingerprint computed" \
    "G-C" 1 "fail" "$FP_RC" "verify.check_failed" "$FP_REASON"
fi
rm -f "$FP_ERR"

# --- task context (classification, scheduling, task fingerprint; design §6.2) --

TASK_JSON=""
TASK_RC=0
if [ -n "$TASK_ID" ]; then
  set +e
  TASK_JSON="$(./scripts/candidate-fingerprint task ".agent/work/$TASK_ID/state.json" 2>/dev/null)"
  TASK_RC=$?
  set -e
fi
CLASS=""
if [ "$TASK_RC" -eq 0 ]; then
  CLASS="$(printf '%s' "$TASK_JSON" | python3 -c \
    'import json,sys; print(json.load(sys.stdin).get("class") or "")' 2>/dev/null || true)"
fi

# --- foundation checks -------------------------------------------------------

check_required_files() {
  local missing=0 f
  for f in README.md AGENTS.md .gitignore spec/README.md \
           spec/fake-jev-technical-spec-v2.md docs/development/agent-workflow.md \
           docs/adr/README.md .agent/README.md \
           docs/agents/README.md .agent/gate-policy.json \
           .agent/schema/role-pack.schema.json \
           .agent/schema/stage-artifact.schema.json \
           .agent/schema/work-item.schema.json \
           scripts/agent-context scripts/verify-candidate \
           scripts/candidate-fingerprint scripts/selftest; do
    if [ ! -f "$f" ]; then
      echo "missing: $f"
      missing=1
    fi
  done
  return "$missing"
}
run_check "required repository files exist" check_required_files

check_scripts_executable() {
  local missing=0 s
  for s in scripts/agent-context scripts/verify-candidate \
           scripts/candidate-fingerprint scripts/selftest; do
    if [ ! -x "$s" ]; then
      echo "not executable: $s"
      missing=1
    fi
  done
  return "$missing"
}
run_check "scripts are executable" check_scripts_executable

check_shell_syntax() {
  bash -n scripts/verify-candidate && bash -n scripts/agent-context
}
run_check "shell syntax: bash -n scripts/*" check_shell_syntax

check_toolchain_python3() {
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found (required by scripts/agent-context)"
    return 1
  fi
  echo "python3: $(command -v python3)"
}
run_check "toolchain: python3 available" check_toolchain_python3

check_spec_present() {
  local spec="spec/fake-jev-technical-spec-v2.md"
  if [ ! -s "$spec" ]; then
    echo "missing or empty: $spec"
    return 1
  fi
  if ! grep -q '^## 0\. Normative status' "$spec"; then
    echo "spec does not look intact (missing section 0 header): $spec"
    return 1
  fi
  echo "spec present: $spec ($(wc -c < "$spec" | tr -d ' ') bytes)"
}
run_check "authoritative spec present and intact" check_spec_present

check_json_files() {
  local bad=0 f
  for f in $(find .agent -name '*.json' -type f | sort); do
    if ! python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$f" 2>/dev/null; then
      echo "malformed JSON: $f"
      bad=1
    fi
  done
  if [ "$bad" -eq 0 ]; then
    echo "all .agent JSON files parse"
  fi
  return "$bad"
}
run_check "all .agent JSON files parse" check_json_files

check_work_item_schema() {
  python3 - <<'PY'
import json, pathlib, sys

REQUIRED = ["id", "title", "phase", "objective", "status", "acceptance",
            "allowedFiles", "verificationCommands", "nextAction"]
STATUSES = {"planned", "ready", "implementing", "verifying", "review",
            "blocked", "complete"}
STAGES = ["specifier", "coder", "cleaner", "hardener", "qa"]
LISTS = ["specReferences", "relevantFiles", "allowedFiles", "acceptance",
         "nonGoals", "verificationCommands", "notes"]
# Active execution must be leased: two agents sharing one tree need to know who
# owns a work item. Verification fails closed on a missing or contended lease.
LEASE_REQUIRED = {"implementing", "verifying"}

failed = False
paths = sorted(pathlib.Path(".agent/work").glob("*/state.json"))
if not paths:
    print("no work items found (ok during foundation phase)")
claims = {}
for p in paths:
    try:
        data = json.loads(p.read_text())
    except Exception as exc:
        print(f"{p}: malformed: {exc}")
        failed = True
        continue
    problems = []
    for key in REQUIRED:
        if key not in data:
            problems.append(f"missing field: {key}")
    if data.get("id") != p.parent.name:
        problems.append(f"id {data.get('id')!r} does not match directory {p.parent.name!r}")
    if data.get("status") not in STATUSES:
        problems.append(f"status {data.get('status')!r} not in vocabulary")
    stage = data.get("stage", None)
    if stage is not None and stage not in STAGES:
        problems.append(f"stage {stage!r} not in vocabulary or null")
    for key in LISTS:
        if key in data and not isinstance(data[key], list):
            problems.append(f"{key} must be a list")
    if "verificationCommands" in data and isinstance(data["verificationCommands"], list):
        if any(not isinstance(c, str) or not c.strip() for c in data["verificationCommands"]):
            problems.append("verificationCommands entries must be non-empty strings")
    lease = data.get("leaseOwner")
    if lease is not None and (not isinstance(lease, str) or not lease.strip()):
        problems.append("leaseOwner must be a non-empty string or null")
    elif isinstance(lease, str) and lease.strip():
        claims.setdefault(lease.strip(), []).append(p.parent.name)
    if data.get("status") in LEASE_REQUIRED and not (isinstance(lease, str) and lease.strip()):
        problems.append(f"status {data.get('status')!r} requires a non-empty leaseOwner")
    if problems:
        failed = True
        print(f"{p}:")
        for problem in problems:
            print(f"  - {problem}")
    else:
        print(f"{p}: ok")
for owner in sorted(claims):
    holders = claims[owner]
    if len(holders) > 1:
        failed = True
        print(f"lease conflict: {owner!r} claimed by {', '.join(holders)}")
sys.exit(1 if failed else 0)
PY
}
run_check "work items match the state.json schema" check_work_item_schema

check_role_packs() {
  python3 - <<'PY'
import pathlib
import re
import sys

import yaml

STAGES = ["specifier", "coder", "cleaner", "hardener", "qa"]
GATES = {"specifier": "G-S", "coder": "G-C", "cleaner": "G-L",
         "hardener": "G-H", "qa": "G-Q"}
BLOCKERS = ("spec-gap", "needs-info", "needs-human", "wontfix")
ALLOWED_KEYS = {"id", "stage", "expertise", "inputs", "output", "gate", "escalate"}
EXPERTISE_DIR = pathlib.Path("docs/agents/expertise")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")


class UniqueKeyLoader(yaml.SafeLoader):
    def construct_mapping(self, node, deep=False):
        if not isinstance(node, yaml.MappingNode):
            raise yaml.constructor.ConstructorError(
                None, None,
                "expected a mapping node, but found %s" % node.id,
                node.start_mark)
        mapping = {}
        for key_node, value_node in node.value:
            key = self.construct_object(key_node, deep=deep)
            try:
                duplicate = key in mapping
            except TypeError:
                raise yaml.constructor.ConstructorError(
                    None, None, "found unhashable key",
                    key_node.start_mark) from None
            if duplicate:
                raise yaml.constructor.ConstructorError(
                    None, None, "found duplicate key %r" % (key,),
                    key_node.start_mark)
            mapping[key] = self.construct_object(value_node, deep=deep)
        return mapping


failed = False
packs = sorted(pathlib.Path("docs/agents/roles").glob("*.md"))
if not packs:
    print("no role packs found at docs/agents/roles/")
    sys.exit(1)
for path in packs:
    problems = []
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        problems.append(f"unreadable file: {exc}")
        text = None
    data = None
    if text is not None:
        match = re.match(r"^---\n(.*?)\n---\n", text, re.S)
        if not match:
            problems.append("missing YAML front matter")
        else:
            try:
                loaded = yaml.load(match.group(1), Loader=UniqueKeyLoader)
            except yaml.YAMLError as exc:
                problems.append(f"unparseable front matter: {exc}")
            except RecursionError:
                problems.append("unparseable front matter: recursion limit exceeded")
            else:
                if isinstance(loaded, dict):
                    data = loaded
                elif loaded is None:
                    problems.append("front matter is empty")
                else:
                    problems.append("front matter is not a mapping")
    if data is not None:
        for key in sorted(set(data) - ALLOWED_KEYS, key=str):
            problems.append(f"unknown front-matter key: {key}")
        for key in sorted(ALLOWED_KEYS - set(data)):
            problems.append(f"missing front-matter key: {key}")
        sid, stage = data.get("id"), data.get("stage")
        if stage not in STAGES:
            problems.append(f"stage {stage!r} not in vocabulary")
        if sid is not None and sid != stage:
            problems.append(f"id {sid!r} != stage {stage!r}")
        if stage in STAGES and data.get("gate") != GATES[stage]:
            problems.append(f"gate {data.get('gate')!r} != {GATES[stage]!r} for stage {stage!r}")
        if data.get("output") != ".agent/work/<id>/<stage>.md":
            problems.append(f"output {data.get('output')!r} != '.agent/work/<id>/<stage>.md'")
        expertise = data.get("expertise")
        req, opt = [], []
        if not isinstance(expertise, dict):
            problems.append("expertise must be a mapping")
        else:
            for kind in ("required", "optional"):
                value = expertise.get(kind)
                if not isinstance(value, list):
                    problems.append(f"expertise.{kind} must be a list (even when empty)")
                elif any(not isinstance(item, str) for item in value):
                    problems.append(f"expertise.{kind} entries must be strings")
                elif len(value) != len(set(value)):
                    problems.append(f"expertise.{kind} has duplicates")
                if isinstance(value, list) and all(isinstance(item, str)
                                                   for item in value):
                    if kind == "required":
                        req = value
                    else:
                        opt = value
            for name in sorted(set(req) | set(opt)):
                if not NAME_RE.fullmatch(name):
                    problems.append(f"invalid expertise name: {name}")
                    continue
                if not (EXPERTISE_DIR / f"{name}.md").is_file():
                    problems.append(f"dangling expertise reference: {name}")
            overlap = sorted(set(req) & set(opt))
            if overlap:
                problems.append(f"expertise required and optional overlap: {overlap}")
        inputs = data.get("inputs")
        if not isinstance(inputs, list) or any(not isinstance(x, str) for x in inputs):
            problems.append("inputs must be a list of strings")
        escalate = data.get("escalate")
        if not isinstance(escalate, list):
            problems.append("escalate must be a list")
        else:
            for index, entry in enumerate(escalate):
                if not isinstance(entry, dict) or set(entry) != {"condition", "blocker"}:
                    problems.append(f"escalate[{index}] must be exactly {{condition, blocker}}")
                    continue
                if entry.get("blocker") not in BLOCKERS:
                    problems.append(f"escalate[{index}].blocker {entry.get('blocker')!r} not in vocabulary")
                if not isinstance(entry.get("condition"), str) or not entry.get("condition").strip():
                    problems.append(f"escalate[{index}].condition must be a non-empty string")
    else:
        failed = True
        print(f"{path}:")
        for problem in problems:
            print(f"  - {problem}")
        continue
    if problems:
        failed = True
        print(f"{path}:")
        for problem in problems:
            print(f"  - {problem}")
    else:
        print(f"{path}: ok")
named = {pack.stem for pack in packs}
for stage in STAGES:
    if stage not in named:
        failed = True
        print(f"missing role pack: docs/agents/roles/{stage}.md")
sys.exit(1 if failed else 0)
PY
}
if python3 -c 'import yaml' >/dev/null 2>&1; then
  run_check "role packs match the role-pack contract" check_role_packs
else
  skip_check "role packs match the role-pack contract" check_role_packs \
    "PyYAML not importable (design §4 conditional)" "toolchain.pyyaml_missing"
fi

# --- gauntlet engine: policy rows (evidence rows arrive in Task 6) ------------
# Rows are TSV: name, gate, required, result, exitCode, code, display, reason.
# The engine exits non-zero only on internal errors; check outcomes travel as
# rows (failures are data, not a crashed run).
ENGINE_ROWS="$(mktemp)"
ENGINE_ERR="$(mktemp)"
set +e
python3 - "$TASK_ID" "$CAND_FP" "$TASK_JSON" "$TASK_RC" "$ENGINE_ROWS" \
  <<'PY' 2>"$ENGINE_ERR"
import json
import os
import sys

TASK_ID, CAND_FP, TASK_JSON, TASK_RC, OUT_PATH = sys.argv[1:6]

CANONICAL = ["specifier", "coder", "cleaner", "hardener", "qa"]
STAGE_GATES = {"specifier": "G-S", "coder": "G-C", "cleaner": "G-L",
               "hardener": "G-H", "qa": "G-Q"}
GATE_IDS = set(STAGE_GATES.values())

out = open(OUT_PATH, "w", encoding="utf-8")


def clean(value):
    return str(value).replace("\t", " ").replace("\n", " ").replace("\r", " ")


def emit(name, gate, required, result, exit_code, code, display, reason=""):
    out.write("\t".join([
        name, gate, "1" if required else "0", result, str(exit_code),
        code, clean(display), clean(reason),
    ]) + "\n")


def load_json(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def exemption_rows():
    """§9.2: every exemption needs an existing, non-complete trackedBy item."""
    path = ".agent/gate-policy.json"
    if not os.path.isfile(path):
        return  # absence already fails repo.required_files_missing
    unknown, stale = [], []
    exemptions = None
    try:
        data = load_json(path)
    except ValueError:
        unknown.append("gate-policy.json is not valid JSON")
        data = None
    if isinstance(data, dict):
        exemptions = data.get("exemptions")
    if not isinstance(exemptions, list):
        unknown.append("exemptions must be a list")
        exemptions = []
    for index, exemption in enumerate(exemptions):
        label = f"exemptions[{index}]"
        if not isinstance(exemption, dict):
            unknown.append(f"{label} must be an object")
            continue
        shape_ok = True
        for key in ("gate", "blocks", "scope", "code", "reason", "trackedBy"):
            if key not in exemption:
                unknown.append(f"{label} missing {key}")
                shape_ok = False
        if shape_ok:
            if exemption["gate"] not in GATE_IDS:
                unknown.append(f"{label}.gate {exemption['gate']!r} is not a known gate")
                shape_ok = False
            for key in ("blocks", "scope"):
                value = exemption[key]
                if (not isinstance(value, list) or not value
                        or not all(isinstance(item, str) for item in value)):
                    unknown.append(f"{label}.{key} must be a non-empty list of strings")
                    shape_ok = False
            if not isinstance(exemption.get("code"), str) or not exemption["code"]:
                unknown.append(f"{label}.code must be a non-empty string")
                shape_ok = False
            if not isinstance(exemption.get("reason"), str) or not exemption["reason"].strip():
                unknown.append(f"{label}.reason must be a non-empty string")
                shape_ok = False
        if not shape_ok:
            continue
        tracked = exemption["trackedBy"]
        if not isinstance(tracked, str) or not tracked.strip():
            unknown.append(f"{label}.trackedBy must be a non-empty string")
            continue
        state_path = f".agent/work/{tracked}/state.json"
        if not os.path.isfile(state_path):
            unknown.append(f"{label}.trackedBy {tracked}: no such work item")
            continue
        try:
            state = load_json(state_path)
        except ValueError:
            unknown.append(f"{label}.trackedBy {tracked}: unreadable state.json")
            continue
        if state.get("status") == "complete":
            stale.append(f"{label}.trackedBy {tracked} reached complete "
                         "— remove the exemption or ship the tooling")
    if unknown:
        emit("policy.exemptions.unknown", "G-C", True, "fail", 1,
             "policy.exemption_unknown",
             "trackedBy references resolve to existing work items",
             "; ".join(unknown))
    else:
        emit("policy.exemptions.unknown", "G-C", True, "pass", 0,
             "policy.exemption_unknown",
             "trackedBy references resolve to existing work items",
             f"{len(exemptions)} exemption(s) checked")
    if stale:
        emit("policy.exemptions.stale", "G-C", True, "fail", 1,
             "policy.exemption_stale", "trackedBy items are not complete",
             "; ".join(stale))
    else:
        emit("policy.exemptions.stale", "G-C", True, "pass", 0,
             "policy.exemption_stale", "trackedBy items are not complete", "")


def required_stages_problems(info, state):
    """First violation of §8's additive-only rules, or (None, None)."""
    effective = info.get("requiredStages") or []
    derived = info.get("derivedRequiredStages")
    source = info.get("source")
    justification = state.get("requiredStagesJustification")
    if source == "explicit":
        if (any(stage not in CANONICAL for stage in effective)
                or len(effective) != len(set(effective))):
            return ("policy.invalid_stages",
                    "requiredStages must contain unique vocabulary stages")
        order = [CANONICAL.index(stage) for stage in effective]
        if order != sorted(order):
            return ("policy.invalid_stages",
                    "requiredStages must be an ordered subsequence of the stage vocabulary")
        if derived:
            if any(stage not in effective for stage in derived):
                missing = ", ".join(stage for stage in derived if stage not in effective)
                return ("policy.stage_reduction_forbidden",
                        f"explicit requiredStages omits derived stage(s): {missing}")
            relative = [stage for stage in effective if stage in derived]
            if relative != derived:
                return ("policy.stage_reduction_forbidden",
                        "explicit requiredStages reorders derived stages")
            if effective == derived:
                if justification is not None:
                    return ("policy.justification_required",
                            "requiredStagesJustification must be absent when the "
                            "explicit list equals the derived value")
            elif not isinstance(justification, str) or not justification.strip():
                return ("policy.justification_required",
                        "requiredStagesJustification (non-empty) required when the "
                        "explicit list adds stages")
        # class unknown with an explicit list: derivation impossible, and the
        # classification row already failed — nothing further to check here.
    elif source == "derived":
        if justification is not None:
            return ("policy.justification_required",
                    "requiredStagesJustification must be absent when the list is derived")
    return (None, None)


def task_policy_rows():
    if TASK_RC == "2":
        # malformed state: the schema check may not catch every shape error —
        # fail closed here instead of emitting no policy rows.
        emit("policy.classification", "G-C", True, "fail", 1, "agent.work_item_schema",
             "allowedFiles classify to product or metadata",
             "state.json is malformed (candidate-fingerprint task mode exit 2)")
        return
    if TASK_RC == "3":
        emit("policy.classification", "G-C", True, "fail", 1, "policy.unknown_scope",
             "allowedFiles classify to product or metadata",
             "cannot classify allowedFiles (unknown scope)")
        return
    if TASK_RC != "0" or not TASK_JSON:
        emit("policy.classification", "G-C", True, "fail", 1, "verify.check_failed",
             "allowedFiles classify to product or metadata",
             "candidate-fingerprint task mode failed unexpectedly")
        return
    info = json.loads(TASK_JSON)
    try:
        state = load_json(f".agent/work/{TASK_ID}/state.json")
    except ValueError as exc:
        emit("policy.classification", "G-C", True, "fail", 1,
             "agent.work_item_schema", "allowedFiles classify to product or metadata",
             f"state.json unreadable: {exc}")
        return
    cls = info.get("class")
    if cls == "unknown":
        emit("policy.classification", "G-C", True, "fail", 1, "policy.unknown_scope",
             "allowedFiles classify to product or metadata",
             "path outside the product/metadata classes")
    else:
        emit("policy.classification", "G-C", True, "pass", 0, "policy.unknown_scope",
             "allowedFiles classify to product or metadata", f"class={cls}")
    code, reason = required_stages_problems(info, state)
    if code:
        emit("policy.required_stages", "G-C", True, "fail", 1, code,
             "requiredStages is a valid additive-only ordered set", reason)
    else:
        emit("policy.required_stages", "G-C", True, "pass", 0, "policy.invalid_stages",
             "requiredStages is a valid additive-only ordered set",
             "source=%s stages=%s" % (info.get("source"),
                                      ",".join(info.get("requiredStages") or [])))


exemption_rows()
if TASK_ID:
    task_policy_rows()
out.close()
PY
ENGINE_RC=$?
set -e
if [ "$ENGINE_RC" -ne 0 ]; then
  ENGINE_REASON="$(tr '\n' ' ' < "$ENGINE_ERR")"
  printf '==> gauntlet engine\n    FAIL (code verify.check_failed)\n\n'
  record_row "check_engine" "gauntlet engine" "G-C" 1 "fail" "$ENGINE_RC" \
    "verify.check_failed" "$ENGINE_REASON"
else
  while IFS=$'\t' read -r e_name e_gate e_required e_result e_exit e_code \
      e_display e_reason; do
    [ -n "$e_name" ] || continue
    case "$e_result" in
      pass)           printf '==> %s\n    PASS\n\n' "$e_display" ;;
      fail)           printf '==> %s\n    FAIL (exit %s, code %s)\n\n' \
                        "$e_display" "$e_exit" "$e_code" ;;
      skipped)        printf '==> %s\n    SKIPPED: %s\n\n' "$e_display" "$e_reason" ;;
      not_applicable) printf '==> %s\n    NOT APPLICABLE: %s\n\n' \
                        "$e_display" "$e_reason" ;;
    esac
    record_row "$e_name" "$e_display" "$e_gate" "$e_required" "$e_result" \
      "$e_exit" "$e_code" "$e_reason"
  done < "$ENGINE_ROWS"
fi
rm -f "$ENGINE_ROWS" "$ENGINE_ERR"

# --- product checks (activated as phases land) -------------------------------

# Repository-owned packages only. Tool-managed skill installs live inside the
# module but are gitignored; their sample .go files are not part of this
# repository's verification. Anything else that fails to load must fail loudly.
NON_REPO_DIRS="agent .agents .claude .pi .scratch"

repo_packages() {
  local import_path dir rel excluded=0 line
  while IFS= read -r line; do
    import_path="${line%% *}"
    dir="${line#* }"
    if [ -z "$import_path" ] || [ "$dir" = "$line" ]; then
      printf '%s\n' "$line" >&2
      continue
    fi
    rel="${dir#"$REPO_ROOT"/}"
    for skip in $NON_REPO_DIRS; do
      case "$rel" in
        "$skip"|"$skip"/*)
          excluded=$((excluded + 1))
          continue 2 ;;
      esac
    done
    printf '%s\n' "$import_path"
  done < <(go list -e -f '{{.ImportPath}} {{.Dir}}' ./...)
  if [ "$excluded" -gt 0 ]; then
    echo "verify-candidate: excluded $excluded package(s) under gitignored tool dirs ($NON_REPO_DIRS)" >&2
  fi
}

check_go_test() {
  local pkgs
  pkgs="$(repo_packages | tr '\n' ' ')"
  if [ -z "${pkgs// /}" ]; then
    echo "no repository Go packages discovered"
    return 1
  fi
  go test $pkgs
}

check_go_vet() {
  local pkgs
  pkgs="$(repo_packages | tr '\n' ' ')"
  if [ -z "${pkgs// /}" ]; then
    echo "no repository Go packages discovered"
    return 1
  fi
  go vet $pkgs
}

check_go_build() { go build ./cmd/fake-jev; }

# Go checks are required iff class == product (design §8.3). metadata items get
# not_applicable/stage.not_required (§9.3); an unknown class or a missing module
# runs them non-required so foundation work is never deadlocked (interpretation
# note 1). A product item with go.mod but no packages yet skips non-required
# until something exists to test (interpretation note 1b).
ALL_PKGS="$(repo_packages 2>/dev/null || true)"
case "$CLASS" in
  metadata)
    na_check "go test (repository packages)" check_go_test "stage.not_required" \
      "class metadata (design §9.3)"
    na_check "go vet (repository packages)" check_go_vet "stage.not_required" \
      "class metadata (design §9.3)"
    na_check "go build ./cmd/fake-jev" check_go_build "stage.not_required" \
      "class metadata (design §9.3)"
    ;;
  product)
    if [ -f go.mod ]; then
      if [ -z "${ALL_PKGS//[$'\n\t ']/}" ]; then
        skip_check "go test (repository packages)" check_go_test \
          "no repository Go packages yet" "" 0
        skip_check "go vet (repository packages)" check_go_vet \
          "no repository Go packages yet" "" 0
      else
        run_check "go test (repository packages)" check_go_test 1
        run_check "go vet (repository packages)" check_go_vet 1
      fi
      if [ -d cmd/fake-jev ]; then
        run_check "go build ./cmd/fake-jev" check_go_build 1
      else
        skip_check "go build ./cmd/fake-jev" check_go_build \
          "cmd/fake-jev does not exist yet" "" 0
      fi
    else
      skip_check "go test (repository packages)" check_go_test \
        "no go.mod yet (foundation phase)" "" 0
      skip_check "go vet (repository packages)" check_go_vet \
        "no go.mod yet (foundation phase)" "" 0
      skip_check "go build ./cmd/fake-jev" check_go_build \
        "no go.mod yet (foundation phase)" "" 0
    fi
    ;;
  *)
    if [ -f go.mod ]; then
      run_check "go test (repository packages)" check_go_test 0
      run_check "go vet (repository packages)" check_go_vet 0
      if [ -d cmd/fake-jev ]; then
        run_check "go build ./cmd/fake-jev" check_go_build 0
      else
        skip_check "go build ./cmd/fake-jev" check_go_build \
          "cmd/fake-jev does not exist yet" "" 0
      fi
    else
      skip_check "go test (repository packages)" check_go_test \
        "no go.mod yet (foundation phase)" "" 0
      skip_check "go vet (repository packages)" check_go_vet \
        "no go.mod yet (foundation phase)" "" 0
      skip_check "go build ./cmd/fake-jev" check_go_build \
        "no go.mod yet (foundation phase)" "" 0
    fi
    ;;
esac

# --- aggregate: status + report ----------------------------------------------

ROWS_TSV="$(mktemp)"
STATUS_FILE="$(mktemp)"
: > "$ROWS_TSV"
for i in "${!CHECK_NAMES[@]}"; do
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${CHECK_NAMES[$i]}" "${CHECK_GATES[$i]}" "${CHECK_REQUIRED[$i]}" \
    "${CHECK_RESULTS[$i]}" "${CHECK_EXITS[$i]}" "${CHECK_CODES[$i]}" \
    "${CHECK_EXEMPTED[$i]}" "${CHECK_CMDS[$i]}" "${CHECK_REASONS[$i]}" \
    >> "$ROWS_TSV"
done

if [ -n "$TASK_ID" ]; then
  mkdir -p ".agent/reports/$TASK_ID"
  REPORT_PATH=".agent/reports/$TASK_ID/report-$(date -u +%Y%m%dT%H%M%SZ).json"
else
  REPORT_PATH=""
fi
FINISHED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

export ROWS_TSV STATUS_FILE REPORT_PATH TASK_ID STARTED_AT FINISHED_AT REVISION
export TASK_JSON TASK_RC
export CAND_FP="${CAND_FP:-}"
export GIT_JSON TREE_CLEAN TREE_STAGED TREE_UNSTAGED TREE_UNTRACKED

python3 - <<'PY'
import json
import os

VALID_RESULTS = {"pass", "fail", "skipped", "not_applicable"}

rows = []
with open(os.environ["ROWS_TSV"], encoding="utf-8") as handle:
    for line in handle:
        # split(..., 8) folds any surplus tabs into the last field instead of
        # crashing the unpack; short lines are padded below.
        parts = line.rstrip("\n").split("\t", 8)
        while len(parts) < 9:
            parts.append("")
        (name, gate, required_field, result, exit_code, code, exempted,
         display, reason) = parts
        issues = []
        required_issue = None
        if required_field in ("0", "1"):
            required = required_field == "1"
        else:
            # Fail closed: anything that is not exactly "0" marks the row
            # required, so a corrupt required field can never demote a row.
            required = True
            required_issue = "invalid required vocabulary: %r" % required_field
        if result not in VALID_RESULTS:
            issues.append("invalid result vocabulary: %r" % result)
        if exit_code in ("-1", ""):
            exit_value = None
        else:
            try:
                exit_value = int(exit_code)
            except ValueError:
                exit_value = None
                issues.append("invalid exitCode vocabulary: %r" % exit_code)
        if result == "pass" and exit_value not in (None, 0):
            issues.append("result pass recorded with nonzero exitCode")
        rows.append({
            "name": name,
            "gate": gate,
            "required": required,
            "result": result,
            "exitCode": exit_value,
            "code": code,
            "exempted": exempted == "1",
            "command": display,
            "reason": reason or None,
            "_issues": issues,
            "_required_issue": required_issue,
        })

# Design §9.1: a required check may never be not_applicable — an invalid
# combination is materialized as fail/gate.invalid_result (interpretation note 4).
for row in rows:
    if row["required"] and row["result"] == "not_applicable":
        row["result"] = "fail"
        row["code"] = "gate.invalid_result"
        row["reason"] = "required check reported not_applicable"

# Fail closed on malformed row data, mirroring note 4: an unrecognized result
# token, an unparseable exitCode, or a pass/nonzero-exit contradiction rewrites
# the row to required fail/gate.invalid_result, and a corrupt required field
# does the same whenever the row is not already blocking. Corrupt input can
# therefore never yield status passed while a row carries a fail indication or
# a nonzero exitCode.
for row in rows:
    issues = row.pop("_issues")
    required_issue = row.pop("_required_issue")
    row_blocking = row["required"] and (
        row["result"] == "fail"
        or (row["result"] == "skipped" and not row["exempted"]))
    if issues:
        if required_issue:
            issues.append(required_issue)
        row["result"] = "fail"
        row["code"] = "gate.invalid_result"
        row["reason"] = "; ".join(issues)
        row["required"] = True
    elif required_issue and not row_blocking:
        row["result"] = "fail"
        row["code"] = "gate.invalid_result"
        row["reason"] = required_issue
        row["required"] = True

blocking = [row for row in rows if row["required"] and (
    row["result"] == "fail"
    or (row["result"] == "skipped" and not row["exempted"]))]
status = "failed" if blocking else "passed"

counts = {"pass": 0, "fail": 0, "skipped": 0, "not_applicable": 0}
for row in rows:
    counts[row["result"]] = counts.get(row["result"], 0) + 1

report_path = os.environ.get("REPORT_PATH") or ""
if report_path:
    clean = os.environ.get("TREE_CLEAN")
    tree = {
        "gitAvailable": os.environ.get("GIT_JSON") == "true",
        "clean": True if clean == "true" else (False if clean == "false" else None),
        "staged": int(os.environ.get("TREE_STAGED") or 0),
        "unstaged": int(os.environ.get("TREE_UNSTAGED") or 0),
        "untracked": int(os.environ.get("TREE_UNTRACKED") or 0),
    }
    info = None
    task_json = os.environ.get("TASK_JSON") or ""
    if task_json and os.environ.get("TASK_RC") == "0":
        try:
            info = json.loads(task_json)
        except ValueError:
            info = None
    report = {
        "taskId": os.environ.get("TASK_ID") or None,
        "candidateFingerprint": os.environ.get("CAND_FP") or None,
        "taskFingerprint": (info or {}).get("taskFingerprint"),
        "policy": (
            {"class": info.get("class"),
             "requiredStages": info.get("requiredStages"),
             "source": info.get("source")}
            if info else None),
        "revision": os.environ.get("REVISION") or "unknown",
        "treeState": tree,
        "startedAt": os.environ.get("STARTED_AT"),
        "finishedAt": os.environ.get("FINISHED_AT"),
        "status": status,
        "checks": rows,
    }
    with open(report_path, "w", encoding="utf-8") as handle:
        json.dump(report, handle, indent=2)
        handle.write("\n")
    print("report: %s" % report_path)

print("summary: %d passed, %d failed, %d skipped, %d not_applicable"
      % (counts.get("pass", 0), counts.get("fail", 0),
         counts.get("skipped", 0), counts.get("not_applicable", 0)))
with open(os.environ["STATUS_FILE"], "w", encoding="utf-8") as handle:
    handle.write(status)
PY

OVERALL="$(cat "$STATUS_FILE")"
rm -f "$ROWS_TSV" "$STATUS_FILE"
echo
if [ "$OVERALL" = "passed" ]; then
  echo "RESULT: PASS"
  exit 0
fi
echo "RESULT: FAIL"
exit 1
