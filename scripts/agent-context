#!/usr/bin/env bash
# agent-context <task-id>
#
# Compile .agent/work/<task-id>/state.json into a concise, deterministic task packet
# for an implementation agent. The packet is bounded context: it references spec
# sections and files instead of dumping them.
#
# Offline, no external services, no timestamps in the output (same input -> same
# output). Requires python3 (JSON parsing/formatting only).
#
# Exit codes: 0 ok; 1 usage; 2 no such work item; 3 malformed/invalid state.json;
#             4 python3 unavailable.

set -euo pipefail

usage() {
  echo "usage: $0 <task-id>" >&2
  echo "example: $0 FJ-017" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage
TASK_ID="$1"

case "$TASK_ID" in
  */*|*..*|"") echo "ERROR: invalid task id: $TASK_ID" >&2; exit 1 ;;
esac

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_FILE="$REPO_ROOT/.agent/work/$TASK_ID/state.json"

if [ ! -f "$STATE_FILE" ]; then
  echo "ERROR: no work item at .agent/work/$TASK_ID/state.json" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: python3 is required to read state.json" >&2
  exit 4
fi

# Orientation inputs: the packet reports the repository as it is now (§4 of the
# operating model — report, do not assume). Works in a dirty checkout; degrades
# to "unknown" when git metadata is unavailable. No wall-clock values.
ORIENT_GIT=0
ORIENT_REV=""
ORIENT_STAGED=0
ORIENT_UNSTAGED=0
ORIENT_UNTRACKED=0
ORIENT_RECENT=""
if command -v git >/dev/null 2>&1 && git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  ORIENT_GIT=1
  ORIENT_REV="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  ORIENT_RECENT="$(git -C "$REPO_ROOT" log --oneline -5 2>/dev/null || true)"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    x="${line:0:1}"
    y="${line:1:1}"
    if [ "$x" = "?" ] && [ "$y" = "?" ]; then
      ORIENT_UNTRACKED=$((ORIENT_UNTRACKED + 1))
      continue
    fi
    if [ "$x" != " " ]; then
      ORIENT_STAGED=$((ORIENT_STAGED + 1))
    fi
    if [ "$y" != " " ]; then
      ORIENT_UNSTAGED=$((ORIENT_UNSTAGED + 1))
    fi
  done < <(git -C "$REPO_ROOT" status --porcelain 2>/dev/null || true)
fi
export ORIENT_GIT ORIENT_REV ORIENT_STAGED ORIENT_UNSTAGED ORIENT_UNTRACKED
export ORIENT_RECENT REPO_ROOT

python3 - "$TASK_ID" "$STATE_FILE" <<'PY'
import json
import os
import sys

task_id, state_file = sys.argv[1], sys.argv[2]

try:
    with open(state_file, encoding="utf-8") as handle:
        state = json.load(handle)
except json.JSONDecodeError as exc:
    print(f"ERROR: malformed state.json: {exc}", file=sys.stderr)
    sys.exit(3)
except OSError as exc:
    print(f"ERROR: cannot read {state_file}: {exc}", file=sys.stderr)
    sys.exit(3)

if not isinstance(state, dict):
    print("ERROR: state.json must contain a JSON object", file=sys.stderr)
    sys.exit(3)

errors = []
if state.get("id") != task_id:
    errors.append(f"id {state.get('id')!r} does not match directory {task_id!r}")
for field in ("objective", "status"):
    if not isinstance(state.get(field), str) or not state.get(field, "").strip():
        errors.append(f"missing or empty required field: {field}")
for field in ("specReferences", "relevantFiles", "allowedFiles", "acceptance",
              "nonGoals", "verificationCommands", "blockers", "notes"):
    if field in state and not isinstance(state[field], list):
        errors.append(f"{field} must be a list")
if errors:
    for problem in errors:
        print(f"ERROR: {problem}", file=sys.stderr)
    sys.exit(3)


def block(title, items, empty="(none)"):
    print(title)
    if items:
        for item in items:
            if isinstance(item, dict):
                kind = item.get("type")
                desc = item.get("description", "")
                print(f"  - [{kind}] {desc}" if kind else f"  - {desc}")
            else:
                print(f"  - {item}")
    else:
        print(f"  {empty}")
    print()


def line_or_none(value):
    if value is None or value == "":
        return "(none)"
    return str(value)


def orientation():
    """Report the repository as it is now: root, revision, deltas, recent commits."""
    print("ORIENTATION")
    print(f"  repository: {os.environ.get('REPO_ROOT')}")
    git = os.environ.get("ORIENT_GIT") == "1"
    rev = os.environ.get("ORIENT_REV") or ""
    dirty = False
    if git:
        print(f"  revision: {rev or '(no commits yet)'}")
        staged = int(os.environ.get("ORIENT_STAGED") or 0)
        unstaged = int(os.environ.get("ORIENT_UNSTAGED") or 0)
        untracked = int(os.environ.get("ORIENT_UNTRACKED") or 0)
        dirty = bool(staged or unstaged or untracked)
        if dirty:
            print(f"  tree: DIRTY ({staged} staged, {unstaged} unstaged, {untracked} untracked)")
        else:
            print("  tree: clean")
        recent = [l for l in os.environ.get("ORIENT_RECENT", "").splitlines() if l.strip()]
        if recent:
            print("  recent commits:")
            for entry in recent:
                print(f"    - {entry}")
    else:
        print("  revision: (unknown — no git metadata)")
        print("  tree: (unknown)")
    print()
    return git, rev, dirty


def evidence_freshness(git, rev, dirty):
    """Distinguish passed, failed, missing and stale evidence for this item."""
    print("EVIDENCE FRESHNESS")
    last = state.get("lastVerification")
    if not isinstance(last, dict) or not last:
        print("  none recorded for this work item")
    elif not git or not rev:
        print(f"  unknown (no current revision); last recorded at "
              f"{line_or_none(last.get('revision'))} status {line_or_none(last.get('status'))}")
    else:
        recorded = last.get("revision")
        status = line_or_none(last.get("status"))
        if recorded != rev:
            print(f"  STALE — verified {line_or_none(recorded)} ({status}), current {rev}: "
                  f"rerun before trusting it")
        elif last.get("status") == "passed":
            suffix = ("; tree is dirty, so evidence covers the revision plus local changes"
                      if dirty else "")
            print(f"  fresh — passed at {rev}{suffix}")
        else:
            print(f"  latest run at {rev} is {status}")
    print()


GIT, REV, DIRTY = orientation()


print("WORK ITEM")
print(task_id)
print(f"phase: {line_or_none(state.get('phase'))}  |  "
      f"status: {line_or_none(state.get('status'))}  |  "
      f"attempts: {state.get('attempts', 0)}  |  "
      f"role: {line_or_none(state.get('assignedRole'))}")
print(f"lease: {line_or_none(state.get('leaseOwner'))}  |  "
      f"base revision: {line_or_none(state.get('baseRevision'))}  |  "
      f"candidate revision: {line_or_none(state.get('candidateRevision'))}")
print()

print("OBJECTIVE")
print(state.get("objective", "").strip())
print()

print("STATUS")
print(state.get("status", "(none)"))
print()

print("SPEC REFERENCES")
print("  authoritative: spec/fake-jev-technical-spec-v2.md")
references = state.get("specReferences") or []
if references:
    for reference in references:
        print(f"  - {reference}")
else:
    print("  (none specified — read only the sections the objective requires)")
print()

block("RELEVANT FILES", state.get("relevantFiles") or [])
block("ALLOWED FILES", state.get("allowedFiles") or [],
      empty="(none — do not modify any files)")

block("ACCEPTANCE", state.get("acceptance") or [])
block("NON-GOALS", state.get("nonGoals") or [])

print("LAST VERIFICATION")
last = state.get("lastVerification")
if isinstance(last, dict):
    print(f"  status: {line_or_none(last.get('status'))}  |  "
          f"revision: {line_or_none(last.get('revision'))}  |  "
          f"finished: {line_or_none(last.get('finishedAt'))}")
    if last.get("report"):
        print(f"  report: {last['report']}")
elif last:
    print(f"  {last}")
else:
    print("  (none)")
print()
evidence_freshness(GIT, REV, DIRTY)

block("BLOCKERS", state.get("blockers") or [])

print("NEXT ACTION")
print(line_or_none(state.get("nextAction")))
print()

print("VERIFY")
for command in state.get("verificationCommands") or []:
    print(f"  {command}")
if not state.get("verificationCommands"):
    print(f"  ./scripts/verify-candidate {task_id}")
print()

if state.get("notes"):
    block("NOTES", state["notes"])

print("---")
print("Bounded context only. Open the referenced spec sections and relevant files")
print("as needed; do not load the whole specification. Edit only ALLOWED FILES,")
print("then run VERIFY and update .agent/work/%s/state.json." % task_id)
PY
