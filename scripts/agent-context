#!/usr/bin/env bash
# agent-context <task-id>
#
# Compile .agent/work/<task-id>/state.json into a concise, deterministic task packet
# for an implementation agent. The packet is bounded context: it references spec
# sections and files instead of dumping them.
#
# Offline, no external services, no timestamps in the output (same input -> same
# output). Requires python3 (JSON parsing/formatting only).
#
# Exit codes: 0 ok; 1 usage; 2 no such work item; 3 malformed/invalid state.json;
#             4 python3 unavailable.

set -euo pipefail

usage() {
  echo "usage: $0 <task-id>" >&2
  echo "example: $0 FJ-017" >&2
  exit 1
}

[ "$#" -eq 1 ] || usage
TASK_ID="$1"

case "$TASK_ID" in
  */*|*..*|"") echo "ERROR: invalid task id: $TASK_ID" >&2; exit 1 ;;
esac

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_FILE="$REPO_ROOT/.agent/work/$TASK_ID/state.json"

if [ ! -f "$STATE_FILE" ]; then
  echo "ERROR: no work item at .agent/work/$TASK_ID/state.json" >&2
  exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "ERROR: python3 is required to read state.json" >&2
  exit 4
fi

# Orientation inputs: the packet reports the repository as it is now (§4 of the
# operating model — report, do not assume). Works in a dirty checkout; degrades
# to "unknown" when git metadata is unavailable. No wall-clock values.
ORIENT_GIT=0
ORIENT_REV=""
ORIENT_STAGED=0
ORIENT_UNSTAGED=0
ORIENT_UNTRACKED=0
ORIENT_RECENT=""
if command -v git >/dev/null 2>&1 && git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  ORIENT_GIT=1
  ORIENT_REV="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || true)"
  ORIENT_RECENT="$(git -C "$REPO_ROOT" log --oneline -5 2>/dev/null || true)"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    x="${line:0:1}"
    y="${line:1:1}"
    if [ "$x" = "?" ] && [ "$y" = "?" ]; then
      ORIENT_UNTRACKED=$((ORIENT_UNTRACKED + 1))
      continue
    fi
    if [ "$x" != " " ]; then
      ORIENT_STAGED=$((ORIENT_STAGED + 1))
    fi
    if [ "$y" != " " ]; then
      ORIENT_UNSTAGED=$((ORIENT_UNSTAGED + 1))
    fi
  done < <(git -C "$REPO_ROOT" status --porcelain 2>/dev/null || true)
fi
export ORIENT_GIT ORIENT_REV ORIENT_STAGED ORIENT_UNSTAGED ORIENT_UNTRACKED
export ORIENT_RECENT REPO_ROOT

# Fingerprints for the §10 views. Shared implementation, computed from the
# repository root; degrades to empty when the tooling is absent or the digest
# is not a plausible 64-hex value (non-git checkouts, partial output) — the
# packet must never crash.
CAND_FP=""
TASK_JSON=""
if [ -x "$REPO_ROOT/scripts/candidate-fingerprint" ]; then
  CAND_FP="$(cd "$REPO_ROOT" && ./scripts/candidate-fingerprint candidate 2>/dev/null || true)"
  TASK_JSON="$(cd "$REPO_ROOT" && ./scripts/candidate-fingerprint task "$STATE_FILE" 2>/dev/null || true)"
fi
case "$CAND_FP" in
  *[!0-9a-f]*|"") CAND_FP="" ;;   # keep only a plausible digest
esac
if [ "${#CAND_FP}" -lt 64 ]; then
  CAND_FP=""
fi
export CAND_FP TASK_JSON

python3 - "$TASK_ID" "$STATE_FILE" <<'PY'
import json
import os
import re
import sys

task_id, state_file = sys.argv[1], sys.argv[2]

try:
    with open(state_file, encoding="utf-8") as handle:
        state = json.load(handle)
except json.JSONDecodeError as exc:
    print(f"ERROR: malformed state.json: {exc}", file=sys.stderr)
    sys.exit(3)
except OSError as exc:
    print(f"ERROR: cannot read {state_file}: {exc}", file=sys.stderr)
    sys.exit(3)

if not isinstance(state, dict):
    print("ERROR: state.json must contain a JSON object", file=sys.stderr)
    sys.exit(3)

errors = []
if state.get("id") != task_id:
    errors.append(f"id {state.get('id')!r} does not match directory {task_id!r}")
for field in ("objective", "status"):
    if not isinstance(state.get(field), str) or not state.get(field, "").strip():
        errors.append(f"missing or empty required field: {field}")
for field in ("specReferences", "relevantFiles", "allowedFiles", "acceptance",
              "nonGoals", "verificationCommands", "blockers", "notes"):
    if field in state and not isinstance(state[field], list):
        errors.append(f"{field} must be a list")
if errors:
    for problem in errors:
        print(f"ERROR: {problem}", file=sys.stderr)
    sys.exit(3)

REPO = os.environ.get("REPO_ROOT") or "."
CAND_FP = os.environ.get("CAND_FP") or ""

# Task context from candidate-fingerprint task mode (§6.2). Absent or unusable
# renders the gauntlet views as unavailable instead of guessing (design §10).
info = None
raw_info = os.environ.get("TASK_JSON") or ""
if raw_info:
    try:
        parsed = json.loads(raw_info)
    except ValueError:
        parsed = None
    if isinstance(parsed, dict) and isinstance(parsed.get("taskFingerprint"), str):
        info = parsed

explicit_stages = state.get("requiredStages")
explicit_stages = explicit_stages if isinstance(explicit_stages, list) else []
stages = list(info.get("requiredStages") or []) if info else explicit_stages
REQUIRED_TEXT = ",".join(stages) if stages else "(none)"
TASK_TEXT = info["taskFingerprint"] if info else "(unknown)"

STAGE_NAMES = ["specifier", "coder", "cleaner", "hardener", "qa"]
STAGE_GATES = {"specifier": "G-S", "coder": "G-C", "cleaner": "G-L",
               "hardener": "G-H", "qa": "G-Q"}
STAGE_DISPLAY = {"qa": "QA"}   # every other stage title-cases


def block(title, items, empty="(none)"):
    print(title)
    if items:
        for item in items:
            if isinstance(item, dict):
                kind = item.get("type")
                desc = item.get("description", "")
                print(f"  - [{kind}] {desc}" if kind else f"  - {desc}")
            else:
                print(f"  - {item}")
    else:
        print(f"  {empty}")
    print()


def line_or_none(value):
    if value is None or value == "":
        return "(none)"
    return str(value)


# --- gauntlet view (design §7, §8.1, §10) ------------------------------------

ARTIFACT_KEYS = {"stage", "task", "inputFingerprint", "outputFingerprint",
                 "taskFingerprint", "gitHead", "generatedAt"}
HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
TASK_ID_RE = re.compile(r"\AFJ-[A-Za-z0-9-]+\Z")


def parse_artifact(path):
    """Stage-artifact front matter (design §5) under the same rules the engine
    applies: `key: value` lines only, exact seven-key set, stage/task/digest
    validation. Returns (header, body); raises ValueError when invalid."""
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    if not text.startswith("---\n"):
        raise ValueError("missing front matter")
    end = text.find("\n---\n", 4)
    if end < 0:
        raise ValueError("unterminated front matter")
    header = {}
    for line in text[4:end].splitlines():
        if line != line.lstrip() or ": " not in line:
            raise ValueError("invalid front matter line: %r" % line)
        key, value = line.split(": ", 1)
        if key in header:
            raise ValueError("duplicate front matter key: %s" % key)
        header[key] = value
    if set(header) != ARTIFACT_KEYS:
        raise ValueError("front matter keys %s != %s"
                         % (sorted(header), sorted(ARTIFACT_KEYS)))
    if header["stage"] not in STAGE_NAMES:
        raise ValueError("unknown stage %r" % header["stage"])
    if not TASK_ID_RE.match(header["task"]):
        raise ValueError("invalid task %r" % header["task"])
    for key in ("inputFingerprint", "outputFingerprint", "taskFingerprint"):
        if not HEX64.match(header[key]):
            raise ValueError("%s is not a 64-hex digest" % key)
    return header, text[end + 5:]


def due_stages(status, current_stage, required):
    """§8.1 due set for display — the same rules `scripts/candidate-fingerprint`
    scheduling() applies (interpretation note 8): display never invents its own."""
    if status in ("planned", "ready", "blocked"):
        return []
    if status in ("review", "complete"):
        return list(required)
    if current_stage in required:
        stop = required.index(current_stage)
        return required[:stop] if status == "implementing" else required[:stop + 1]
    return list(required)  # no stage, or a stage outside requiredStages: fail-closed


def covered_stage(status, current_stage, required):
    """Terminal-freshness coverage (§7): verifying → the current stage when it
    is required; review/complete → the last required stage; nothing otherwise."""
    if status == "verifying":
        return current_stage if current_stage in required else None
    if status in ("review", "complete"):
        return required[-1] if required else None
    return None


def artifact_state(stage, status, current_stage, required, tfp):
    """§7/§8.1 freshness for one stage, recomputed from fingerprints:
    not required | pending | missing | invalid | stale | fresh."""
    if stage not in required:
        return "not required"
    if stage not in due_stages(status, current_stage, required):
        return "pending"
    path = os.path.join(REPO, ".agent", "work", task_id, "%s.md" % stage)
    if not os.path.isfile(path):
        return "missing"
    try:
        header, _body = parse_artifact(path)
    except (ValueError, OSError):
        return "invalid"
    if header["stage"] != stage or header["task"] != task_id:
        return "invalid"
    if header["taskFingerprint"] != tfp:
        return "stale"
    position = required.index(stage)
    if position > 0:
        previous = os.path.join(REPO, ".agent", "work", task_id,
                                "%s.md" % required[position - 1])
        try:
            prior, _prior_body = parse_artifact(previous)
        except (ValueError, OSError):
            pass  # the predecessor's own row reports it
        else:
            if prior["outputFingerprint"] != header["inputFingerprint"]:
                return "stale"
    if covered_stage(status, current_stage, required) == stage and CAND_FP \
            and header["outputFingerprint"] != CAND_FP:
        return "stale"
    return "fresh"


def reports_exist():
    directory = os.path.join(REPO, ".agent", "reports", task_id)
    if not os.path.isdir(directory):
        return False
    return any(name.startswith("report-") and name.endswith(".json")
               for name in os.listdir(directory))


def load_report():
    """Newest report bound to BOTH current fingerprints (§10); a report bound
    to either older fingerprint is ignored here — it surfaces in EVIDENCE
    FRESHNESS instead. Lexical sort: report names are UTC timestamps."""
    if info is None or not CAND_FP:
        return None
    directory = os.path.join(REPO, ".agent", "reports", task_id)
    if not os.path.isdir(directory):
        return None
    names = sorted(name for name in os.listdir(directory)
                   if name.startswith("report-") and name.endswith(".json"))
    for name in reversed(names):
        try:
            with open(os.path.join(directory, name), encoding="utf-8") as handle:
                report = json.load(handle)
        except (ValueError, OSError):
            continue
        if not isinstance(report, dict):
            continue
        if report.get("candidateFingerprint") == CAND_FP \
                and report.get("taskFingerprint") == info["taskFingerprint"]:
            return report
    return None


def gate_display(stage, report, due, required):
    """Collapse a stage's required gate rows from the bound report (§10):
    fail > exempt > pass; not applicable/not run outside the due set."""
    if stage not in required:
        return "not applicable"
    if stage not in due:
        return "not run"
    rows = []
    if isinstance(report, dict):
        rows = [c for c in report.get("checks") or []
                if isinstance(c, dict) and c.get("gate") == STAGE_GATES[stage]]
    if not rows:
        return "not run"
    if any(c.get("required") and (
            c.get("result") == "fail"
            or (c.get("result") == "skipped" and not c.get("exempted")))
           for c in rows):
        return "fail"
    if any(c.get("required") and c.get("exempted") for c in rows):
        return "exempt"
    return "pass"


def gauntlet_block():
    """Design §10: one row per stage of the vocabulary — artifacts recomputed
    from fingerprints, gates collapsed from the latest bound report."""
    print("GAUNTLET")
    if info is None:
        print("  (unavailable — task fingerprint could not be computed)")
        print()
        return
    status = state.get("status")
    current = state.get("stage") if isinstance(state.get("stage"), str) else None
    required = [s for s in (info.get("requiredStages") or []) if s in STAGE_NAMES]
    due = set(due_stages(status, current, required))
    report = load_report()
    for stage in STAGE_NAMES:
        print("  %-11s artifact: %-9s gate: %s"
              % (STAGE_DISPLAY.get(stage, stage.capitalize()),
                 artifact_state(stage, status, current, required,
                                info["taskFingerprint"]),
                 gate_display(stage, report, due, required)))
    print("  candidate: %s  task: %s"
          % (CAND_FP or "(unknown)", info["taskFingerprint"]))
    print()


def role_pack_expertise(stage):
    """Front matter of docs/agents/roles/<stage>.md parsed without PyYAML —
    agent-context stays stdlib-only. Tracks the two-space `required:` /
    `optional:` keys, collects four-space `    - name` items, resets on any
    other top-level key. Returns the two lists, or None when the pack is
    missing/unparseable."""
    path = os.path.join(REPO, "docs", "agents", "roles", "%s.md" % stage)
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as handle:
        text = handle.read()
    match = re.match(r"\A---\n(.*?)\n---\n", text, re.S)
    if not match:
        return None
    lists = {"required": [], "optional": []}
    current = None
    for line in match.group(1).splitlines():
        if line.startswith("  required:") or line.startswith("  optional:"):
            current = "required" if line.startswith("  required:") else "optional"
        elif line.startswith("    - ") and current:
            lists[current].append(line[6:].strip())
        elif not line.startswith("    "):
            current = None
    return lists


def expertise_block():
    """Design §10: required packs as paths to read, optional as pointers."""
    print("EXPERTISE")
    stage = state.get("stage") if isinstance(state.get("stage"), str) else None
    if not stage:
        print("  (no active stage — start at docs/agents/README.md)")
        print()
        return
    lists = role_pack_expertise(stage)
    if lists is None:
        print("  (role pack missing: docs/agents/roles/%s.md)" % stage)
        print()
        return
    print("required (read these):")
    if lists["required"]:
        for name in lists["required"]:
            print("  docs/agents/expertise/%s.md" % name)
    else:
        print("    (none)")
    print("optional (pointers):")
    if lists["optional"]:
        for name in lists["optional"]:
            print("  %s" % name)
    else:
        print("    (none)")
    print()


def orientation():
    """Report the repository as it is now: root, revision, deltas, recent commits."""
    print("ORIENTATION")
    print(f"  repository: {os.environ.get('REPO_ROOT')}")
    git = os.environ.get("ORIENT_GIT") == "1"
    rev = os.environ.get("ORIENT_REV") or ""
    dirty = False
    if git:
        print(f"  revision: {rev or '(no commits yet)'}")
        staged = int(os.environ.get("ORIENT_STAGED") or 0)
        unstaged = int(os.environ.get("ORIENT_UNSTAGED") or 0)
        untracked = int(os.environ.get("ORIENT_UNTRACKED") or 0)
        dirty = bool(staged or unstaged or untracked)
        if dirty:
            print(f"  tree: DIRTY ({staged} staged, {unstaged} unstaged, {untracked} untracked)")
        else:
            print("  tree: clean")
        recent = [l for l in os.environ.get("ORIENT_RECENT", "").splitlines() if l.strip()]
        if recent:
            print("  recent commits:")
            for entry in recent:
                print(f"    - {entry}")
    else:
        print("  revision: (unknown — no git metadata)")
        print("  tree: (unknown)")
    print()
    return git, rev, dirty


def evidence_freshness(git, rev, dirty):
    """Distinguish passed, failed, missing and stale evidence for this item."""
    print("EVIDENCE FRESHNESS")
    last = state.get("lastVerification")
    if not isinstance(last, dict) or not last:
        print("  none recorded for this work item")
    elif not git or not rev:
        print(f"  unknown (no current revision); last recorded at "
              f"{line_or_none(last.get('revision'))} status {line_or_none(last.get('status'))}")
    else:
        recorded = last.get("revision")
        status = line_or_none(last.get("status"))
        if recorded != rev:
            print(f"  STALE — verified {line_or_none(recorded)} ({status}), current {rev}: "
                  f"rerun before trusting it")
        elif last.get("status") == "passed":
            suffix = ("; tree is dirty, so evidence covers the revision plus local changes"
                      if dirty else "")
            print(f"  fresh — passed at {rev}{suffix}")
        else:
            print(f"  latest run at {rev} is {status}")
    if info is not None and reports_exist() and load_report() is None:
        print("  latest report is bound to an older fingerprint — rerun verify-candidate")
    print()


GIT, REV, DIRTY = orientation()


print("WORK ITEM")
print(task_id)
print(f"phase: {line_or_none(state.get('phase'))}  |  "
      f"status: {line_or_none(state.get('status'))}  |  "
      f"attempts: {state.get('attempts', 0)}  |  "
      f"role: {line_or_none(state.get('assignedRole'))}")
print(f"lease: {line_or_none(state.get('leaseOwner'))}  |  "
      f"base revision: {line_or_none(state.get('baseRevision'))}  |  "
      f"candidate revision: {line_or_none(state.get('candidateRevision'))}")
print(f"stage: {line_or_none(state.get('stage'))}  |  requiredStages: {REQUIRED_TEXT}")
print(f"candidate: {CAND_FP or '(unknown)'}  |  task: {TASK_TEXT}")
print()

print("OBJECTIVE")
print(state.get("objective", "").strip())
print()

print("STATUS")
print(state.get("status", "(none)"))
print()

gauntlet_block()

print("SPEC REFERENCES")
print("  authoritative: spec/fake-jev-technical-spec-v2.md")
references = state.get("specReferences") or []
if references:
    for reference in references:
        print(f"  - {reference}")
else:
    print("  (none specified — read only the sections the objective requires)")
print()

block("RELEVANT FILES", state.get("relevantFiles") or [])
block("ALLOWED FILES", state.get("allowedFiles") or [],
      empty="(none — do not modify any files)")

expertise_block()

block("ACCEPTANCE", state.get("acceptance") or [])
block("NON-GOALS", state.get("nonGoals") or [])

print("LAST VERIFICATION")
last = state.get("lastVerification")
if isinstance(last, dict):
    print(f"  status: {line_or_none(last.get('status'))}  |  "
          f"revision: {line_or_none(last.get('revision'))}  |  "
          f"finished: {line_or_none(last.get('finishedAt'))}")
    if last.get("report"):
        print(f"  report: {last['report']}")
elif last:
    print(f"  {last}")
else:
    print("  (none)")
print()
evidence_freshness(GIT, REV, DIRTY)

block("BLOCKERS", state.get("blockers") or [])

print("NEXT ACTION")
print(line_or_none(state.get("nextAction")))
print()

print("VERIFY")
for command in state.get("verificationCommands") or []:
    print(f"  {command}")
if not state.get("verificationCommands"):
    print(f"  ./scripts/verify-candidate {task_id}")
print()

if state.get("notes"):
    block("NOTES", state["notes"])

print("---")
print("Bounded context only. Open the referenced spec sections and relevant files")
print("as needed; do not load the whole specification. Edit only ALLOWED FILES,")
print("then run VERIFY and update .agent/work/%s/state.json." % task_id)
PY
